#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-or-later
#
# agent-profile: Agent Profile Manager
#
# Keeps several AI agent accounts separate on one machine by giving each its
# own config root, and audits that the separation actually holds.
#
# Written to bash 3.2, the system bash on macOS. No associative arrays, no
# mapfile, no ${var^^}. python3 is used only to read JSON.

set -u

AGENT_PROFILE_VERSION="0.8.0"
AGENT_PROFILE_LICENSE="GPL-3.0-or-later"

# The name this was invoked as. Every message names the command the reader
# actually typed, so an install under a short name never tells them to run
# something that is not on their PATH. Falls back when $0 is not a plain name.
SELF="${0##*/}"
case "$SELF" in
    ''|*[!A-Za-z0-9_.-]*) SELF="agent-profile" ;;
esac

# The agent version docs/FACTS.md was last checked against.
AGENT_PROFILE_VERIFIED_AGAINST="2.1.263"

# Exit codes. Contracted so doctor and verify are usable unattended.
EX_OK=0        # success, no findings
EX_ERR=1       # usage error, unknown profile, unknown agent, missing dependency
EX_FINDINGS=2  # doctor found at least one isolation problem
EX_BROKEN=3    # verify found an assumption that no longer holds
EX_UNCHECKED=4 # verify could not check something it wanted to check

# ---------------------------------------------------------------------------
# Overridable locations. Tests redirect the whole world into a fixture tree by
# setting these; nothing else in the script hard-codes a path outside a root.
# ---------------------------------------------------------------------------

: "${AGENT_PROFILE_REGISTRY:=$HOME/.config/agent-profiles}"
: "${AGENT_PROFILE_APPS_DIR:=$HOME/Applications}"
: "${AGENT_PROFILE_APP_BUNDLE:=/Applications/Claude.app}"

# Where to look for launchers that were not created by this tool. Colon
# separated like PATH, with the same consequence: a directory whose name
# contains a colon cannot be searched. Nobody has one, and inventing a second
# separator to cover it would cost more than it saves.
#
# The Desktop is in the list because that is where real launchers turned out to
# be. Assuming they live in ~/Applications is how a machine ends up audited
# less than it appears to be.
: "${AGENT_PROFILE_APPLET_DIRS:=$AGENT_PROFILE_APPS_DIR:$HOME/Desktop:/Applications}"
: "${AGENT_PROFILE_DRY_RUN:=}"

# Lets the suite exercise the interactive picker by piping answers. Faking a
# terminal instead would mean script(1), whose arguments differ between the
# BSD one on macOS and the util-linux one elsewhere, so the tests would be
# least reliable on the platform this tool targets.
: "${AGENT_PROFILE_ASSUME_TTY:=}"

# Where 'version --check' asks what the newest release is. Overridable so the
# suite can answer with a fixture instead of the network, and so a fork can be
# followed without editing this file.
: "${AGENT_PROFILE_RELEASE_API_URL:=https://api.github.com/repos/mmsge/agent-profile-manager/releases/latest}"

# Resolved once so the test suite can exercise the macOS-only audit rules on
# another platform rather than shipping them unrun.
: "${AGENT_PROFILE_PLATFORM:=$(uname -s)}"

# ---------------------------------------------------------------------------
# The agent seam.
#
# This function is the only place that knows anything agent-specific. Adding
# ollama or codex later means adding a case here, not migrating the registry.
# ---------------------------------------------------------------------------

KNOWN_AGENTS="claude"

# agent_def <agent> <field>
#
# Fields:
#   envvar        environment variable that selects the config root
#   binary        the agent's CLI executable
#   root_prefix   basename prefix for a conventional per-profile root
#   default_root  the root the agent uses when nothing is pinned
#   state_file    agent state file that sits beside the default root
#   state_base    basename of that state file, as found inside a pinned root
#   cred_service  Keychain service name, before the per-root suffix
#   url_handler   bundle that registers the agent's deep-link scheme
#   url_scheme    that scheme
#   app_prefix    directory-name prefix for the desktop app's data dir
#   app_support   parent directory for desktop app data dirs
#   app_bundle    the desktop app itself, resolved by open -a rather than by
#                 a path to a binary inside it (docs/FACTS.md F05)
#   app_flag      the flag that selects the app's own data directory
#   applet_prefix name prefix for the AppleScript applet that launches it
agent_def() {
    _ad_agent="$1"
    _ad_field="$2"
    case "$_ad_agent" in
        claude)
            case "$_ad_field" in
                envvar)       printf '%s\n' "CLAUDE_CONFIG_DIR" ;;
                binary)       printf '%s\n' "claude" ;;
                root_prefix)  printf '%s\n' ".claude-" ;;
                default_root) printf '%s\n' "$HOME/.claude" ;;
                state_file)   printf '%s\n' "$HOME/.claude.json" ;;
                state_base)   printf '%s\n' ".claude.json" ;;
                cred_service) printf '%s\n' "Claude Code-credentials" ;;
                url_handler)  printf '%s\n' "$HOME/Applications/Claude Code URL Handler.app" ;;
                url_scheme)   printf '%s\n' "claude-cli" ;;
                app_prefix)   printf '%s\n' "Claude-" ;;
                app_support)  printf '%s\n' "$HOME/Library/Application Support" ;;
                app_bundle)   printf '%s\n' "$AGENT_PROFILE_APP_BUNDLE" ;;
                app_flag)     printf '%s\n' "--user-data-dir" ;;
                applet_prefix) printf '%s\n' "Claude-" ;;
                *) die "internal: unknown agent field '$_ad_field'" ;;
            esac
            ;;
        *)
            die "unknown agent '$_ad_agent' (known: $KNOWN_AGENTS)"
            ;;
    esac
}

is_known_agent() {
    for _ika in $KNOWN_AGENTS; do
        [ "$_ika" = "$1" ] && return 0
    done
    return 1
}

# ---------------------------------------------------------------------------
# The IDE seam.
#
# An IDE extension is a third launch path, beside the shell and the desktop
# app, and the one nobody sees: it starts a session from inside the editor, so
# the guard function is never consulted and no applet is involved. What reaches
# the agent is whatever environment the IDE process happens to hold, which for
# a Dock or Spotlight launch is nothing (docs/FACTS.md F19).
#
# Everything IDE-specific lives here, so adding Windsurf later is a case in
# this function rather than a change to D16 or to the launcher.
#
# Fields:
#   label      the IDE's name, as a reader would say it
#   app        the application name open(1) resolves, and the default for --app
#   kind       vscode or jetbrains: which shape the install check takes, and
#              which of the two mechanisms in F19 applies
#   command    the subcommand of this tool that launches it pinned
#   ext_dirs   colon-separated directories that hold installed extensions.
#              Same consequence as AGENT_PROFILE_APPLET_DIRS: a directory whose
#              name contains a colon cannot be searched
#   ext_name   for kind vscode, the prefix of the extension directory's name;
#              for kind jetbrains, the exact plugin directory name, found one
#              level down under <entry>/plugins
#   ext_probe  the one directory whose existence means this IDE keeps its
#              extensions on this machine. It is not in ext_dirs because
#              "the IDE is here" and "here is where its extensions are" are
#              different questions, and verify needs the first one
KNOWN_IDES="vscode cursor jetbrains"

ide_def() {
    _id_ide="$1"
    _id_field="$2"
    case "$_id_ide" in
        vscode)
            case "$_id_field" in
                label)    printf '%s\n' "VS Code" ;;
                app)      printf '%s\n' "Visual Studio Code" ;;
                kind)     printf '%s\n' "vscode" ;;
                command)  printf '%s\n' "code" ;;
                ext_dirs) printf '%s\n' "$HOME/.vscode/extensions" ;;
                ext_name) printf '%s\n' "anthropic.claude-code-" ;;
                ext_probe) printf '%s\n' "$HOME/.vscode" ;;
                *) die "internal: unknown ide field '$_id_field'" ;;
            esac
            ;;
        cursor)
            case "$_id_field" in
                label)    printf '%s\n' "Cursor" ;;
                app)      printf '%s\n' "Cursor" ;;
                kind)     printf '%s\n' "vscode" ;;
                command)  printf '%s\n' "code" ;;
                ext_dirs) printf '%s\n' "$HOME/.cursor/extensions" ;;
                ext_name) printf '%s\n' "anthropic.claude-code-" ;;
                ext_probe) printf '%s\n' "$HOME/.cursor" ;;
                *) die "internal: unknown ide field '$_id_field'" ;;
            esac
            ;;
        jetbrains)
            case "$_id_field" in
                label)    printf '%s\n' "a JetBrains IDE" ;;
                app)      printf '%s\n' "IntelliJ IDEA" ;;
                kind)     printf '%s\n' "jetbrains" ;;
                command)  printf '%s\n' "idea" ;;
                # The three roots the agent's own plugin detection searches on
                # macOS, in its order (docs/FACTS.md F21).
                ext_dirs) printf '%s\n' "$HOME/Library/Application Support/JetBrains:$HOME/Library/Application Support:$HOME/Library/Application Support/Google" ;;
                ext_name) printf '%s\n' "claude-code-jetbrains-plugin" ;;
                ext_probe) printf '%s\n' "$HOME/Library/Application Support/JetBrains" ;;
                *) die "internal: unknown ide field '$_id_field'" ;;
            esac
            ;;
        *)
            die "unknown IDE '$_id_ide' (known: $KNOWN_IDES)"
            ;;
    esac
}

# ides_for_command <code|idea>: the IDEs that subcommand can launch.
ides_for_command() {
    for _ifc in $KNOWN_IDES; do
        [ "$(ide_def "$_ifc" command)" = "$1" ] && printf '%s\n' "$_ifc"
    done
}

# ide_scan <ide>: every installed extension directory for that IDE, one per
# line, empty when none is installed.
#
# Directories, not `code --list-extensions`. The IDE's own CLI is the
# authoritative answer and this reads the weaker one on purpose: an audit reads
# the filesystem and asks the Keychain about named services, and starting an
# IDE binary to answer a question is a different class of act. docs/FACTS.md
# F21 records what that costs, which is every install whose extensions
# directory has been moved.
ide_scan() {
    _is_kind=$(ide_def "$1" kind)
    _is_name=$(ide_def "$1" ext_name)
    _is_dirs=$(ide_def "$1" ext_dirs)
    _is_rest="$_is_dirs"
    while [ -n "$_is_rest" ]; do
        case "$_is_rest" in
            *:*) _is_dir=${_is_rest%%:*}; _is_rest=${_is_rest#*:} ;;
            *)   _is_dir="$_is_rest"; _is_rest="" ;;
        esac
        [ -n "$_is_dir" ] || continue
        [ -d "$_is_dir" ] || continue
        for _is_entry in "$_is_dir"/*; do
            [ -d "$_is_entry" ] || continue
            case "$_is_kind" in
                vscode)
                    _is_base=${_is_entry##*/}
                    case "$_is_base" in
                        "$_is_name"*) printf '%s\n' "$_is_entry" ;;
                    esac
                    ;;
                jetbrains)
                    [ -d "$_is_entry/plugins/$_is_name" ] && \
                        printf '%s\n' "$_is_entry/plugins/$_is_name"
                    ;;
            esac
        done
    done
}

# ide_installed: does any IDE this tool knows keep extensions on this machine?
#
# The difference between "no extension installed" and "no IDE here at all",
# which is what stops verify reporting a scan that found nothing as a pass.
ide_installed() {
    for _iin in $KNOWN_IDES; do
        [ -d "$(ide_def "$_iin" ext_probe)" ] && return 0
    done
    return 1
}

# ---------------------------------------------------------------------------
# Output helpers
# ---------------------------------------------------------------------------

die() {
    printf '%s: %s\n' "$SELF" "$*" >&2
    exit "$EX_ERR"
}

warn() {
    printf '%s: %s\n' "$SELF" "$*" >&2
}

need() {
    command -v "$1" >/dev/null 2>&1 || die "required command '$1' not found"
}

# ---------------------------------------------------------------------------
# Output routing
#
# Every user-facing line that list, doctor and verify produce goes through
# emit(). Prose and the machine-readable document are two renderings of one
# record stream, so they cannot drift apart: there is no second place where
# either of them is written, and a rule that stops printing stops appearing in
# the JSON in the same change.
#
# A record is a level, a kind, and the fields that kind takes. The kind decides
# what a renderer does with it. The level decides who sees it:
#
#   always   reaches the reader even when they asked for less
#   normal   the default
#   detail   reaches the reader only when they asked for more
#   data     never prose; the structured renderings alone
#   prose    never recorded; the terminal alone, for a line about the run
#            itself rather than about the machine being audited
#
# REPORT_LEVEL is the threshold, and only "normal" is reachable today. The
# ordering is here so that a quieter or a more explanatory mode is a change to
# one comparison and a flag, rather than to every call site.
#
# The record stream is captured only when a structured document was asked for,
# so an ordinary run pays nothing for this. Fields are separated by NUL,
# because a path may hold any byte except NUL and a line-based format would
# lose a root whose name contains a newline.
# ---------------------------------------------------------------------------

REPORT_FORMAT=text    # text or json
REPORT_LEVEL=normal   # always, normal or detail
REPORT_FILE=""        # the captured record stream, empty when not capturing
REPORT_PATH=""        # base path for --report, empty when writing no files

# report_rank <level>: levels as numbers, so they can be compared.
report_rank() {
    case "$1" in
        always|prose) printf '0\n' ;;
        normal)       printf '1\n' ;;
        detail)       printf '2\n' ;;
        data)         printf '9\n' ;;
        *)            die "internal: unknown output level '$1'" ;;
    esac
}

# report_shows <level>: does a record at this level reach the reader as prose?
report_shows() {
    [ "$REPORT_FORMAT" = "text" ] || return 1
    [ "$1" != "data" ] || return 1
    [ "$(report_rank "$1")" -le "$(report_rank "$REPORT_LEVEL")" ]
}

# emit <level> <kind> [field...]
#
# The one door. Nothing that a reader or a report consumer is meant to see is
# printed anywhere else.
emit() {
    _em_level="$1"
    case "$_em_level" in
        prose) ;;
        *) [ -z "$REPORT_FILE" ] || report_record "$@" ;;
    esac
    if report_shows "$_em_level"; then
        shift
        report_prose "$@"
    fi
}

# report_record <level> <kind> [field...]: append one record to the stream.
report_record() {
    {
        printf '%s\0%s\0%s\0' "$1" "$2" "$(($# - 2))"
        shift 2
        for _rr_field in "$@"; do
            printf '%s\0' "$_rr_field"
        done
    } >> "$REPORT_FILE"
}

# report_prose <kind> [field...]: the human rendering of one record.
#
# The layout each kind produces is the layout this tool has always produced.
# Changing a line here changes it everywhere it appears, which is the point.
report_prose() {
    _rp_kind="$1"; shift
    case "$_rp_kind" in
        text)
            for _rp_line in "$@"; do
                printf '%s\n' "$_rp_line"
            done
            ;;
        profile)
            # name agent root root_exists app_data account org sessions
            printf '%s\n' "$1"
            printf '  agent     %s\n' "$2"
            printf '  root      %s' "$3"
            [ "$4" = "yes" ] || printf '   MISSING'
            printf '\n'
            # An account this tool could not read is named as such by the
            # prose. The record keeps it empty, so a consumer gets null rather
            # than a sentence it would have to parse.
            if [ -n "$6" ]; then
                printf '  account   %s\n' "$6"
            else
                printf '  account   (not signed in)\n'
            fi
            [ -z "$7" ] || printf '  org       %s\n' "$7"
            printf '  sessions  %s\n' "$8"
            printf '\n'
            ;;
        finding)
            # rule summary subject detail...
            printf '%s  %s\n' "$1" "$2"
            [ -z "$3" ] || printf '     %s\n' "$3"
            shift 3
            for _rp_line in "$@"; do
                printf '     %s\n' "$_rp_line"
            done
            printf '\n'
            ;;
        rule_status)
            # rule status reason prose-line...
            shift 3
            [ $# -gt 0 ] || return 0
            for _rp_line in "$@"; do
                printf '%s\n' "$_rp_line"
            done
            printf '\n'
            ;;
        check)
            # status fact summary detail...
            case "$1" in
                ok)        _rp_label="ok" ;;
                broken)    _rp_label="BROKEN" ;;
                unchecked) _rp_label="unchecked" ;;
                note)      _rp_label="note" ;;
                *)         _rp_label="$1" ;;
            esac
            printf '  %-10s%s  %s\n' "$_rp_label" "$2" "$3"
            shift 3
            for _rp_line in "$@"; do
                printf '                 %s\n' "$_rp_line"
            done
            ;;
        summary)
            # <pairs> <key> <value> ... then the prose lines
            _rp_pairs="$1"; shift
            while [ "$_rp_pairs" -gt 0 ]; do
                shift 2
                _rp_pairs=$((_rp_pairs - 1))
            done
            for _rp_line in "$@"; do
                printf '%s\n' "$_rp_line"
            done
            ;;
        meta|agent|rule_catalog) ;;
        *) die "internal: unknown record kind '$_rp_kind'" ;;
    esac
}

# installed_agent_version <agent>: the version on PATH, empty when absent.
installed_agent_version() {
    _iav_bin=$(agent_def "$1" binary)
    command -v "$_iav_bin" >/dev/null 2>&1 || return 0
    "$_iav_bin" --version 2>/dev/null | head -1 | awk '{print $1}'
}

# report_open <command>: start capturing, and record the document header.
#
# The header is what makes the document evidence rather than a listing: when it
# was produced, by which version of this tool, against which agent version, on
# which machine and as which user.
report_open() {
    need python3
    REPORT_FILE=$(mktemp "${TMPDIR:-/tmp}/agent-profile-report.XXXXXX") || \
        die "could not create a temporary file under ${TMPDIR:-/tmp}"
    trap report_cleanup EXIT INT TERM
    emit data meta \
        command "$1" \
        generated_at "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        tool "$SELF" \
        tool_version "$AGENT_PROFILE_VERSION" \
        verified_against "$AGENT_PROFILE_VERIFIED_AGAINST" \
        hostname "$(uname -n)" \
        user "${USER:-}" \
        platform "$AGENT_PROFILE_PLATFORM" \
        registry "$AGENT_PROFILE_REGISTRY"
    # One entry per agent this tool knows, so the seam stays a seam. Reading a
    # version means running the agent's own binary, which is why it happens
    # here and not on every run.
    for _ro_agent in $KNOWN_AGENTS; do
        emit data agent "$_ro_agent" "$(installed_agent_version "$_ro_agent")"
    done
}

# report_cleanup: the record stream is scratch and must not outlive the run,
# including the runs that end at a die() rather than at the bottom.
report_cleanup() {
    [ -z "$REPORT_FILE" ] || rm -f "$REPORT_FILE"
}

# report_finish: render the captured stream, then discard it.
#
# The files and the document on stdout are rendered from the same stream after
# the same records, so handing someone the file and piping the output give the
# identical document.
report_finish() {
    [ -n "$REPORT_FILE" ] || return 0
    if [ -n "$REPORT_PATH" ]; then
        # Create both files before announcing them, so a report that cannot be
        # written fails here rather than after a line claiming it was.
        : > "$REPORT_PATH.json" || die "could not write $REPORT_PATH.json"
        : > "$REPORT_PATH.md" || die "could not write $REPORT_PATH.md"
        # Where the files went is a fact about this run, not about the machine
        # being audited, so it is said to the terminal and left out of the
        # documents themselves.
        emit prose text "Wrote $REPORT_PATH.json" "Wrote $REPORT_PATH.md"
        report_render json "$REPORT_FILE" > "$REPORT_PATH.json" || \
            die "could not write $REPORT_PATH.json"
        report_render markdown "$REPORT_FILE" > "$REPORT_PATH.md" || \
            die "could not write $REPORT_PATH.md"
    fi
    if [ "$REPORT_FORMAT" = "json" ]; then
        report_render json "$REPORT_FILE"
    fi
    report_cleanup
    REPORT_FILE=""
}

# report_render <json|markdown> <record-file>
#
# The only place a structured document is produced. python3 does the quoting:
# hand-rolling JSON escaping in shell is how a report ends up unparseable on
# the one machine whose paths contain a quote or a backslash.
#
# No field here can carry a credential. The records hold paths, account emails,
# organisation ids and rule text; the tool never reads a credential value in
# the first place, so there is none to leak into a document.
report_render() {
    python3 - "$1" "$2" <<'PY'
import json, sys

fmt, path = sys.argv[1], sys.argv[2]

with open(path, "rb") as fh:
    raw = fh.read()
parts = raw.split(b"\0")
if parts and parts[-1] == b"":
    parts.pop()
fields = [p.decode("utf-8", "replace") for p in parts]

records = []
i = 0
while i + 2 < len(fields):
    level, kind = fields[i], fields[i + 1]
    count = int(fields[i + 2])
    records.append((level, kind, fields[i + 3:i + 3 + count]))
    i += 3 + count

meta = {}
agents = []
profiles = []
findings = []
checks = []
catalog = []
statuses = {}
notes = []
summary = {}
summary_lines = []

for _level, kind, args in records:
    if kind == "meta":
        for key, value in zip(args[0::2], args[1::2]):
            meta[key] = value
    elif kind == "agent":
        agents.append({"agent": args[0], "version": args[1] or None})
    elif kind == "profile":
        profiles.append({
            "name": args[0],
            "agent": args[1],
            "root": args[2],
            "root_exists": args[3] == "yes",
            "app_data": args[4] or None,
            "account": args[5] or None,
            "organization": args[6] or None,
            "sessions": int(args[7]),
        })
    elif kind == "finding":
        findings.append({
            "rule": args[0],
            "summary": args[1],
            "subject": args[2] or None,
            "detail": list(args[3:]),
        })
    elif kind == "check":
        checks.append({
            "status": args[0],
            "fact": args[1],
            "summary": args[2],
            "detail": list(args[3:]),
        })
    elif kind == "rule_catalog":
        catalog.append((args[0], args[1]))
    elif kind == "rule_status":
        statuses[args[0]] = (args[1], args[2])
    elif kind == "text":
        text = "\n".join(args).strip("\n")
        if text.strip():
            notes.append(text)
    elif kind == "summary":
        pairs = int(args[0])
        for key, value in zip(args[1:1 + 2 * pairs:2], args[2:2 + 2 * pairs:2]):
            summary[key] = int(value) if value.lstrip("-").isdigit() else value
        summary_lines = list(args[1 + 2 * pairs:])

command = meta.get("command", "report")

doc = {
    "schema": "agent-profile/" + command,
    "schema_version": 1,
    "command": command,
    "generated_at": meta.get("generated_at"),
    "tool": meta.get("tool"),
    "tool_version": meta.get("tool_version"),
    "verified_against": meta.get("verified_against"),
    "agents": agents,
    "hostname": meta.get("hostname"),
    "user": meta.get("user"),
    "platform": meta.get("platform"),
    "registry": meta.get("registry"),
}

if command in ("doctor", "list"):
    doc["profiles"] = profiles

if command == "doctor":
    rules = []
    for rule, title in catalog:
        hits = [f for f in findings if f["rule"] == rule]
        recorded, reason = statuses.get(rule, ("", ""))
        # A rule that did not run is never reported as passing. "limited" is a
        # rule that ran in a weaker form than it would on a machine that had
        # what it wanted.
        if hits:
            state = "fail"
        elif recorded:
            state = recorded
        else:
            state = "pass"
        rules.append({
            "rule": rule,
            "title": title,
            "status": state,
            "findings": len(hits),
            "reason": reason or None,
        })
    doc["rules"] = rules
    doc["findings"] = findings

if command == "verify":
    doc["checks"] = checks

doc["notes"] = notes
doc["summary"] = summary

if fmt == "json":
    sys.stdout.write(json.dumps(doc, indent=2) + "\n")
    sys.exit(0)


def cell(text):
    return str(text).replace("|", "\\|")


titles = {
    "doctor": "Isolation audit",
    "list": "Profile inventory",
    "verify": "Assumption check",
}
out = []
out.append("# %s" % titles.get(command, "Report"))
out.append("")
out.append("Produced by `%s` %s on %s at %s, as user `%s`." % (
    doc["tool"], doc["tool_version"], doc["hostname"],
    doc["generated_at"], doc["user"] or "not recorded"))
out.append("")
out.append("| Field | Value |")
out.append("| --- | --- |")
out.append("| Generated at | %s |" % cell(doc["generated_at"]))
out.append("| Tool version | %s |" % cell(doc["tool_version"]))
out.append("| Facts verified against | %s |" % cell(doc["verified_against"]))
for entry in agents:
    out.append("| Installed %s | %s |" % (
        cell(entry["agent"]), cell(entry["version"] or "not installed")))
out.append("| Host | %s |" % cell(doc["hostname"]))
out.append("| User | %s |" % cell(doc["user"] or "not recorded"))
out.append("| Platform | %s |" % cell(doc["platform"]))
out.append("| Registry | %s |" % cell(doc["registry"]))
out.append("")

if command in ("doctor", "list"):
    out.append("## Profiles")
    out.append("")
    if profiles:
        out.append("| Profile | Agent | Root | App data | Account | Organisation | Sessions |")
        out.append("| --- | --- | --- | --- | --- | --- | --- |")
        for entry in profiles:
            out.append("| %s | %s | %s | %s | %s | %s | %d |" % (
                cell(entry["name"]), cell(entry["agent"]),
                cell(entry["root"]) + ("" if entry["root_exists"] else " (missing)"),
                cell(entry["app_data"] or ""),
                cell(entry["account"] or "not signed in"),
                cell(entry["organization"] or ""),
                entry["sessions"]))
    else:
        out.append("No profiles are registered.")
    out.append("")

if command == "doctor":
    out.append("## Findings")
    out.append("")
    if findings:
        for entry in findings:
            out.append("### %s %s" % (entry["rule"], entry["summary"]))
            out.append("")
            if entry["subject"]:
                out.append("`%s`" % entry["subject"])
                out.append("")
            for line in entry["detail"]:
                out.append(line)
            out.append("")
    else:
        out.append("No isolation problems were found.")
        out.append("")
    out.append("## Rules")
    out.append("")
    out.append("| Rule | Status | Finding it looks for |")
    out.append("| --- | --- | --- |")
    for entry in doc["rules"]:
        status = entry["status"]
        if entry["reason"]:
            status = "%s (%s)" % (status, entry["reason"])
        out.append("| %s | %s | %s |" % (
            cell(entry["rule"]), cell(status), cell(entry["title"])))
    out.append("")

if command == "verify":
    out.append("## Checks")
    out.append("")
    out.append("| Fact | Status | Result |")
    out.append("| --- | --- | --- |")
    for entry in checks:
        out.append("| %s | %s | %s |" % (
            cell(entry["fact"]), cell(entry["status"]), cell(entry["summary"])))
    out.append("")

if notes:
    out.append("## Notes")
    out.append("")
    for note in notes:
        for line in note.split("\n"):
            out.append(line)
        out.append("")

out.append("## Summary")
out.append("")
for line in summary_lines:
    out.append(line)
    out.append("")
for key in sorted(summary):
    out.append("- %s: %s" % (key, summary[key]))
out.append("")
out.append("No rule reads a credential value, so none appears above. The audit")
out.append("reads paths, file modes, account identity and Keychain attributes only.")
out.append("")

sys.stdout.write("\n".join(out))
PY
}

# ---------------------------------------------------------------------------
# Registry
#
# One file per profile at $AGENT_PROFILE_REGISTRY/<name>.conf, plain key=value.
# Hand-editable and diffable on purpose.
# ---------------------------------------------------------------------------

reg_file() {
    printf '%s\n' "$AGENT_PROFILE_REGISTRY/$1.conf"
}

# reg_get <name> <key>: prints the value, empty if absent.
reg_get() {
    _rg_file=$(reg_file "$1")
    [ -f "$_rg_file" ] || return 0
    # Take the first match only; ignore comments and blank lines.
    sed -n "s/^$2=//p" "$_rg_file" | head -1
}

profile_exists() {
    [ -f "$(reg_file "$1")" ]
}

# profile_names: one per line, sorted. Empty output when the registry is empty.
profile_names() {
    [ -d "$AGENT_PROFILE_REGISTRY" ] || return 0
    for _pn in "$AGENT_PROFILE_REGISTRY"/*.conf; do
        [ -f "$_pn" ] || continue
        _pn=${_pn##*/}
        printf '%s\n' "${_pn%.conf}"
    done
}

# Validates the entry as well as its existence, so no command can operate on a
# profile whose agent is unknown. Falling back to a default agent would be the
# worst possible failure here: it would pin the wrong tool at the wrong root.
require_profile() {
    profile_exists "$1" || die "no such profile '$1' (try: $SELF list)"
    profile_agent "$1" >/dev/null
}

# profile_agent <name>: the agent for a profile, validated.
profile_agent() {
    _pa=$(reg_get "$1" agent)
    [ -n "$_pa" ] || die "profile '$1' has no agent= key; the registry entry is incomplete"
    is_known_agent "$_pa" || die "profile '$1' names unknown agent '$_pa' (known: $KNOWN_AGENTS)"
    printf '%s\n' "$_pa"
}

profile_root() {
    _pr=$(reg_get "$1" root)
    [ -n "$_pr" ] || die "profile '$1' has no root= key; the registry entry is incomplete"
    printf '%s\n' "$_pr"
}

# ---------------------------------------------------------------------------
# Label derivation
#
# The prompt label is resolved from the pinned root every time it is needed and
# is never stored anywhere. That is what stops it drifting away from the root
# it claims to describe, and it is unaffected by asking the registry what that
# root is called: the lookup is still keyed on the root actually in force, on
# every single call.
# ---------------------------------------------------------------------------

# profile_claiming_root <root>: the profile registered at this root, or empty.
# The first match wins; doctor reports two profiles sharing a root separately.
profile_claiming_root() {
    for _pcr_name in $(profile_names); do
        if [ "$(reg_get "$_pcr_name" root)" = "$1" ]; then
            printf '%s\n' "$_pcr_name"
            return 0
        fi
    done
}

# label_for_root <agent> <root>
#
# The root's basename, with the conventional prefix stripped when it is there.
# Deriving it from the root is the whole point: rename a registry entry and the
# label does not follow, because the label was never stored anywhere.
#
# The default root is the one exception, and it has to be. Its basename is
# ".claude", which carries no account at all, and a profile living there cannot
# be moved somewhere better because relocating a root invalidates its login
# (docs/FACTS.md F06). So for that one root, and only that one, the registered
# name is used. An account really does live there on the first machine this
# met.
#
# This is a narrow, deliberate hole in the no-drift property: rename that
# profile's registry entry and its label does follow. The alternative is a
# prompt that says ".claude" and names no account, which is worse. Every other
# root keeps the guarantee, and the test suite pins that boundary.
label_for_root() {
    _lfr_prefix=$(agent_def "$1" root_prefix)
    _lfr_base=${2##*/}
    case "$_lfr_base" in
        "$_lfr_prefix"*) printf '%s\n' "${_lfr_base#"$_lfr_prefix"}"; return 0 ;;
    esac

    if [ "$2" = "$(agent_def "$1" default_root)" ]; then
        _lfr_named=$(profile_claiming_root "$2")
        if [ -n "$_lfr_named" ]; then
            printf '%s\n' "$_lfr_named"
            return 0
        fi
    fi

    printf '%s\n' "$_lfr_base"
}

# ---------------------------------------------------------------------------
# Pinned execution
# ---------------------------------------------------------------------------

# run_pinned <agent> <root> <command> [args...]
#
# Everything that execs goes through here, so AGENT_PROFILE_DRY_RUN=1 makes
# run, shell and desktop assertable in tests without launching anything.
run_pinned() {
    _rp_agent="$1"; shift
    _rp_root="$1"; shift
    _rp_var=$(agent_def "$_rp_agent" envvar)

    if [ -n "$AGENT_PROFILE_DRY_RUN" ]; then
        printf '%s=%s' "$_rp_var" "$_rp_root"
        for _rp_arg in "$@"; do
            printf ' %s' "$_rp_arg"
        done
        printf '\n'
        return 0
    fi

    export "$_rp_var=$_rp_root"
    exec "$@"
}

# open_supports_env: does this macOS open(1) take --env?
#
# The whole desktop half rests on it (docs/FACTS.md F13). Checked rather than
# assumed, because an open without --env would launch the app happily and
# unpinned, which is the precise failure this tool exists to prevent.
open_supports_env() {
    open --help 2>&1 | grep -q -- '--env'
}

# open_pinned <agent> <root> <app-data> [extra open args...]
#
# The desktop counterpart of run_pinned. It does not export the variable and
# must not: open inherits nothing from the invoking shell, so the pin travels
# in --env and nowhere else (docs/FACTS.md F13). Exporting as well would only
# suggest the environment is doing work it is not.
#
# --env comes before --args because everything after --args is handed to the
# application instead of to open. That ordering is the whole trick, so it is
# asserted in the test suite rather than trusted to this comment.
open_pinned() {
    _op_agent="$1"; shift
    _op_root="$1"; shift
    _op_data="$1"; shift
    _op_var=$(agent_def "$_op_agent" envvar)
    _op_bundle=$(agent_def "$_op_agent" app_bundle)
    _op_flag=$(agent_def "$_op_agent" app_flag)

    open_exec open -n -a "$_op_bundle" \
        --env "$_op_var=$_op_root" \
        --args "$_op_flag=$_op_data" "$@"
}

# open_ide <agent> <root> <application> [path]
#
# The IDE counterpart of open_pinned, and the same mechanism: the pin travels
# in --env, because an extension takes its config root from the environment the
# IDE process was started with and from nowhere else (docs/FACTS.md F19).
#
# -n is not decoration here. Without it, open hands the path to an IDE that is
# already running, which is the unpinned one the reader is trying to get away
# from: the window opens, the project opens, and every session in it writes to
# the default root. A second window is the price of the pin actually applying.
#
# --args is emitted only when there is a path, so launching with no path opens
# the IDE rather than opening a file called nothing.
open_ide() {
    _oi_agent="$1"; shift
    _oi_root="$1"; shift
    _oi_app="$1"; shift
    _oi_var=$(agent_def "$_oi_agent" envvar)

    if [ $# -gt 0 ]; then
        open_exec open -n -a "$_oi_app" --env "$_oi_var=$_oi_root" --args "$@"
    else
        open_exec open -n -a "$_oi_app" --env "$_oi_var=$_oi_root"
    fi
}

# open_exec <open> [args...]: print the command under a dry run, exec it
# otherwise. One place, so the two launchers cannot drift apart in what they
# claim to do and what they do.
open_exec() {
    if [ -n "$AGENT_PROFILE_DRY_RUN" ]; then
        _oe_sep=""
        for _oe_arg in "$@"; do
            printf '%s%s' "$_oe_sep" "$_oe_arg"
            _oe_sep=" "
        done
        printf '\n'
        return 0
    fi

    exec "$@"
}

# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

# capitalize <word>: bash 3.2 has no ${var^}, so do it with cut and tr.
capitalize() {
    _cap_first=$(printf '%s' "$1" | cut -c1 | tr '[:lower:]' '[:upper:]')
    _cap_rest=$(printf '%s' "$1" | cut -c2-)
    printf '%s%s\n' "$_cap_first" "$_cap_rest"
}

# shell_quote <string>: single-quote a value so it survives eval intact.
# Paths under ~/Library/Application Support contain spaces, and env output is
# fed straight to eval, so this is not optional.
shell_quote() {
    printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

valid_name() {
    case "$1" in
        ""|*[!A-Za-z0-9_-]*) return 1 ;;
        *) return 0 ;;
    esac
}

# session_count <root>: number of transcripts stored under a root.
session_count() {
    [ -d "$1/projects" ] || { printf '0\n'; return 0; }
    find "$1/projects" -type f -name '*.jsonl' 2>/dev/null | wc -l | tr -d ' '
}

# ---------------------------------------------------------------------------
# new
# ---------------------------------------------------------------------------

cmd_new() {
    _new_name=""
    _new_agent="claude"
    _new_root=""
    _new_appdata=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --agent)     shift; [ $# -gt 0 ] || die "--agent needs a value"; _new_agent="$1" ;;
            --root)      shift; [ $# -gt 0 ] || die "--root needs a value"; _new_root="$1" ;;
            --app-data)  shift; [ $# -gt 0 ] || die "--app-data needs a value"; _new_appdata="$1" ;;
            -*)          die "unknown option '$1'" ;;
            *)           [ -z "$_new_name" ] || die "unexpected argument '$1'"; _new_name="$1" ;;
        esac
        shift
    done

    [ -n "$_new_name" ] || die "usage: $SELF new <name> [--agent NAME] [--root PATH] [--app-data PATH]"
    valid_name "$_new_name" || die "invalid profile name '$_new_name' (letters, digits, dash and underscore only)"
    is_known_agent "$_new_agent" || die "unknown agent '$_new_agent' (known: $KNOWN_AGENTS)"

    [ -n "$_new_root" ] || _new_root="$HOME/$(agent_def "$_new_agent" root_prefix)$_new_name"

    case "$_new_root" in
        /*) ;;
        *)  die "--root must be an absolute path, because the credential is keyed
on the literal path string. Got: $_new_root" ;;
    esac

    # Canonicalise before storing. The credential is keyed on the literal path
    # string, so "/a/b", "/a/b/", "/a//b" and "/a/./b" are four different
    # logins and only one of them is the one the user means. Note that $TMPDIR
    # on macOS ends in a slash, so this is reachable in ordinary use.
    _new_root=$(canonical_path "$_new_root")

    if [ -z "$_new_appdata" ]; then
        _new_appdata="$(agent_def "$_new_agent" app_support)/$(agent_def "$_new_agent" app_prefix)$(capitalize "$_new_name")"
    fi
    _new_appdata=$(canonical_path "$_new_appdata")

    # Idempotent, but never silently relocates: moving a root invalidates its
    # login, because credentials are keyed to the root path.
    if profile_exists "$_new_name"; then
        _new_have_root=$(reg_get "$_new_name" root)
        if [ "$_new_have_root" != "$_new_root" ]; then
            die "profile '$_new_name' is already registered with root '$_new_have_root'.
Refusing to repoint it: credentials are keyed to the root path, so changing it
would invalidate that profile's login. Remove $(reg_file "$_new_name") by hand
if you really mean to start over."
        fi
        printf 'Profile %s is already registered.\n' "$_new_name"
    fi

    # The root is created empty. Nothing is copied or seeded into it, ever.
    # Whether this root already held data decides what to say at the end.
    # Adopting a populated root is a supported and lossless thing to do, and
    # the report has to match: telling someone their live root "is empty" is
    # both false and alarming.
    _new_adopted=""
    if [ -d "$_new_root" ] && [ -n "$(ls -A "$_new_root" 2>/dev/null)" ]; then
        _new_adopted=1
        _new_had_mode=$(dir_mode "$_new_root")
    fi

    # The app data directory gets the same protection as the root. It holds
    # the desktop app's own login (docs/FACTS.md F18) and its embedded copy of
    # the agent (F17), so it is every bit as private, and D07 audits both.
    _new_data_had_mode=""
    [ -d "$_new_appdata" ] && _new_data_had_mode=$(dir_mode "$_new_appdata")

    mkdir -p "$_new_root" || die "could not create root '$_new_root'"
    chmod 700 "$_new_root" || die "could not chmod 700 '$_new_root'"
    mkdir -p "$_new_appdata" || die "could not create app data dir '$_new_appdata'"
    chmod 700 "$_new_appdata" || die "could not chmod 700 '$_new_appdata'"
    mkdir -p "$AGENT_PROFILE_REGISTRY" || die "could not create registry '$AGENT_PROFILE_REGISTRY'"

    if ! profile_exists "$_new_name"; then
        {
            printf 'agent=%s\n' "$_new_agent"
            printf 'root=%s\n' "$_new_root"
            printf 'app_data=%s\n' "$_new_appdata"
            printf 'created=%s\n' "$(date +%Y-%m-%d)"
        } > "$(reg_file "$_new_name")" || die "could not write registry entry"
        printf 'Created profile %s\n' "$_new_name"
    fi

    printf '  agent     %s\n' "$_new_agent"
    printf '  root      %s\n' "$_new_root"
    printf '  app data  %s\n' "$_new_appdata"
    printf '\n'

    if [ -n "$_new_data_had_mode" ] && [ "$_new_data_had_mode" != "700" ]; then
        printf 'The app data directory was mode %s and became 700, which is what doctor D07 wants.\n' \
            "$_new_data_had_mode"
        printf '\n'
    fi

    if [ -n "$_new_adopted" ]; then
        # Say exactly what was and was not done. This command is the entry
        # point for a machine that was set up by hand, so the one thing it
        # must never leave in doubt is whether it touched the data.
        printf 'That root already held data, so it was adopted rather than created.\n'
        printf 'Nothing was copied, moved, seeded or removed: %s session(s) and whatever\n' \
            "$(session_count "$_new_root")"
        printf 'settings, hooks and skills were already there are exactly as they were.\n'
        if [ -n "$_new_had_mode" ] && [ "$_new_had_mode" != "700" ]; then
            printf '\n'
            printf 'The one change: mode %s became 700, which is what doctor D07 wants.\n' "$_new_had_mode"
        fi
        printf '\n'
        printf 'Next: %s list      (check it reports the account you expect)\n' "$SELF"
        printf '      %s doctor    (audit the isolation)\n' "$SELF"
    else
        printf 'The root is empty, which is the point: nothing is shared between profiles.\n'
        printf 'That also means it has no settings, no hooks and none of the guardrails your\n'
        printf 'other profiles may have. Set those up here directly; do not copy them across.\n'
        printf '\n'
        printf 'Next: %s run %s   (it will ask you to log in)\n' "$SELF" "$_new_name"
    fi

    # A profile at the default root costs the audit a rule, permanently, and
    # nothing else says so. Better here, when it is still a choice, than in
    # six months when doctor is quietly reporting less than it appears to.
    if [ "$_new_root" = "$(agent_def "$_new_agent" default_root)" ]; then
        printf '\n'
        printf 'NOTE: this profile owns the default root.\n'
        printf '\n'
        printf 'Anything that runs with nothing pinned writes to that same root, in the same\n'
        printf 'layout, so from now on doctor cannot tell an unpinned run apart from this\n'
        printf "profile's own. D01 goes quiet for good. It is not a bug and there is no\n"
        printf 'setting for it: on disk the two are identical.\n'
        printf '\n'
        printf 'What still watches unpinned use:\n'
        printf '  D02  the state file beside the root, which names whichever account last\n'
        printf '       ran unpinned and need not be any profile here\n'
        printf '  D03  the same project appearing under two roots\n'
        printf '\n'
        printf 'This cannot be undone by moving the root: credentials are keyed to the root\n'
        printf 'path, so relocating it invalidates this login (docs/FACTS.md F06). The real\n'
        printf 'guard is never running the agent unpinned in the first place.\n'
    fi
}

# ---------------------------------------------------------------------------
# Credentials
#
# Existence only. This tool never reads, writes or moves a credential, and
# never calls security with -g, so no secret is ever touched.
#
# Verified against the Claude Code implementation (see docs/FACTS.md F03). The
# service name is built as:
#
#     "Claude Code" + OAUTH_FILE_SUFFIX + "-credentials" + suffix
#
# where suffix is empty when CLAUDE_CONFIG_DIR is unset, and otherwise the
# first 8 hex characters of sha256 over the NFC-normalized *raw value* of the
# variable. The account is $USER.
#
# Two consequences the audit rules below depend on. The suffix is present
# whenever the variable is set at all, so pinning to the default root produces
# a different login from not pinning. And because the hash is over the literal
# string rather than a resolved path, a trailing slash is a different login.
# ---------------------------------------------------------------------------

# cred_info <root>...: emits root<TAB>hash<TAB>form, one python3 call for all.
#
# form is "ok", or names the way the path departs from the form its credential
# is keyed on. Because the hash covers the literal string, "/a/b" and "/a/b/"
# are different logins, so a stored root that is not in canonical form will
# quietly fail to find its own credential.
cred_info() {
    python3 - "$@" <<'PY'
import hashlib, os, sys, unicodedata

for root in sys.argv[1:]:
    form = "ok"
    if not root.startswith("/"):
        form = "not-absolute"
    elif root != root.rstrip("/"):
        form = "trailing-slash"
    elif root != unicodedata.normalize("NFC", root):
        form = "not-nfc"
    elif os.path.normpath(root) != root:
        form = "not-normalized"
    digest = hashlib.sha256(unicodedata.normalize("NFC", root).encode()).hexdigest()
    print("%s\t%s\t%s" % (root, digest[:8], form))
PY
}

# canonical_path <path>: the form cred_info calls "ok". Collapses doubled and
# trailing slashes and "." segments, and normalises to NFC. Does not resolve
# symlinks: the credential is keyed on the string the user exports, not on
# where it eventually points.
canonical_path() {
    python3 -c '
import os, sys, unicodedata
print(os.path.normpath(unicodedata.normalize("NFC", sys.argv[1])))
' "$1"
}

# keychain_available: is there a Keychain to ask at all?
keychain_available() {
    [ "$AGENT_PROFILE_PLATFORM" = "Darwin" ] && command -v security >/dev/null 2>&1
}

# keychain_has <service>: does an entry exist? Existence only, never -g.
keychain_has() {
    security find-generic-password -s "$1" -a "${USER:-}" >/dev/null 2>&1
}

# keychain_services: every Claude credential service name on this machine.
# dump-keychain without -d lists attributes only and reads no secret.
keychain_services() {
    security dump-keychain 2>/dev/null \
        | sed -n 's/.*"svce"<blob>="\(Claude Code[^"]*-credentials[^"]*\)".*/\1/p' \
        | sort -u
}

# ---------------------------------------------------------------------------
# Account identity
#
# One python3 invocation for all roots rather than one per profile. The key is
# oauthAccount in the agent's state file; organizationUuid discriminates
# accounts at different organisations more reliably than the email does.
# ---------------------------------------------------------------------------

# read_accounts <state_basename> <root>...
# Emits: root<TAB>email<TAB>organizationUuid
read_accounts() {
    python3 - "$@" <<'PY'
import json, os, sys

state_base = sys.argv[1]
for root in sys.argv[2:]:
    path = os.path.join(root, state_base)
    email = org = ""
    if os.path.isfile(path):
        try:
            with open(path) as fh:
                data = json.load(fh)
            account = data.get("oauthAccount") or {}
            email = account.get("emailAddress") or ""
            org = account.get("organizationUuid") or ""
        except Exception:
            email = "<unreadable>"
    print("\t".join([root, email, org]))
PY
}

# ---------------------------------------------------------------------------
# The profile inventory
#
# One record per registered profile. list renders them as prose; doctor records
# them without printing them, because its own prose says nothing about a
# healthy profile and must not start, while a document that names findings
# without naming the machine they were found on is evidence of nothing.
# ---------------------------------------------------------------------------

# emit_profiles <level>
emit_profiles() {
    _ep_level="$1"
    _ep_names=$(profile_names)
    [ -n "$_ep_names" ] || return 0

    # Group roots by agent so read_accounts runs once per agent, not once per
    # profile. Roots can contain spaces, so they go through an array.
    for _ep_agent in $KNOWN_AGENTS; do
        _ep_roots=()
        for _ep_name in $_ep_names; do
            [ "$(reg_get "$_ep_name" agent)" = "$_ep_agent" ] || continue
            _ep_roots[${#_ep_roots[@]}]=$(reg_get "$_ep_name" root)
        done
        [ ${#_ep_roots[@]} -gt 0 ] || continue

        _ep_state=$(agent_def "$_ep_agent" state_base)
        _ep_accounts=$(read_accounts "$_ep_state" "${_ep_roots[@]}")

        for _ep_name in $_ep_names; do
            [ "$(reg_get "$_ep_name" agent)" = "$_ep_agent" ] || continue
            _ep_root=$(reg_get "$_ep_name" root)
            _ep_line=$(printf '%s\n' "$_ep_accounts" | awk -F'\t' -v r="$_ep_root" '$1==r {print; exit}')
            _ep_exists=no
            [ -d "$_ep_root" ] && _ep_exists=yes
            emit "$_ep_level" profile \
                "$_ep_name" \
                "$_ep_agent" \
                "$_ep_root" \
                "$_ep_exists" \
                "$(reg_get "$_ep_name" app_data)" \
                "$(printf '%s' "$_ep_line" | cut -f2)" \
                "$(printf '%s' "$_ep_line" | cut -f3)" \
                "$(session_count "$_ep_root")"
        done
    done
}

# ---------------------------------------------------------------------------
# list
# ---------------------------------------------------------------------------

cmd_list() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) REPORT_FORMAT=json ;;
            *) die "list: unknown option '$1' (try: $SELF list --json)" ;;
        esac
        shift
    done

    need python3
    [ "$REPORT_FORMAT" = "text" ] || report_open list

    _list_names=$(profile_names)
    if [ -z "$_list_names" ]; then
        emit normal text \
            "No profiles registered." \
            "" \
            "Create one:  $SELF new <name>"
        emit data summary 2 profiles 0 exit_code "$EX_OK"
        report_finish
        return "$EX_OK"
    fi

    emit_profiles normal
    emit data summary 2 \
        profiles "$(printf '%s\n' "$_list_names" | wc -l | tr -d ' ')" \
        exit_code "$EX_OK"
    report_finish
    return "$EX_OK"
}

# ---------------------------------------------------------------------------
# remove
#
# Retiring a profile when an engagement ends. The machinery that keeps an
# account separate is exactly what makes it hard to leave: a config root, an
# app data directory, a Dock launcher and a Keychain entry, in four different
# places, none of them named after the customer. Finding all four by hand, on
# the day the work stops, is how customer data gets left on a laptop.
#
# Plain remove deletes the registry entry and prints every remaining piece
# with the command that deletes it, so the destructive part stays in the
# reader's hands. --purge does the deleting itself, but only for the paths
# this profile's own registry entry names, only after the name is typed back,
# and only from a terminal.
#
# The credential is never touched either way. The command that deletes it is
# printed and never run: this tool does not read, write or delete a
# credential, and the command that ends an engagement is the last place to
# start.
# ---------------------------------------------------------------------------

# path_claimed_by_other <profile> <path>: another profile whose registry entry
# names this same path, or empty.
#
# Deleting a directory two entries name would take a second account's data
# with it, which is the one mistake this command must never make. Doctor
# reports the root case as D15; this refuses to act on it at all.
path_claimed_by_other() {
    for _pcb_name in $(profile_names); do
        [ "$_pcb_name" = "$1" ] && continue
        for _pcb_key in root app_data applet; do
            if [ "$(reg_get "$_pcb_name" "$_pcb_key")" = "$2" ]; then
                printf '%s\n' "$_pcb_name"
                return 0
            fi
        done
    done
}

# remove_blocker <profile> <path>: empty when --purge may delete this path,
# otherwise the reason it must not. Whatever a blocker names is reported and
# left exactly as it is.
#
# One rule sits behind every check: delete only what a registry entry names,
# only as it names it, and never a path that could stand for somewhere else. A
# symlink is refused rather than followed, because what it points at was never
# this profile's. A path that is not in canonical form is refused because its
# spelling no longer says where it is, and "$HOME/.." is a real directory that
# is not this one.
remove_blocker() {
    case "$2" in
        /*) ;;
        *)  printf 'it is not an absolute path\n'; return 0 ;;
    esac

    if [ "$2" != "$(canonical_path "$2")" ]; then
        printf 'the registry spells it in a form that is not canonical, so what it names is not clear\n'
        return 0
    fi

    if [ "$2" = "/" ] || [ "$2" = "$HOME" ]; then
        printf 'it is your home directory, or the root of the filesystem\n'
        return 0
    fi

    case "$HOME/" in
        "$2"/*) printf 'your home directory is inside it\n'; return 0 ;;
    esac

    if [ -L "$2" ]; then
        printf 'it is a symlink, and what it points at is not this profile\n'
        return 0
    fi

    if [ ! -d "$2" ]; then
        printf 'it is not a directory\n'
        return 0
    fi

    _rb_other=$(path_claimed_by_other "$1" "$2")
    if [ -n "$_rb_other" ]; then
        printf 'profile %s names it too, so it holds more than this account\n' "$_rb_other"
        return 0
    fi
}

# purge_path <path>: delete one item, all or nothing at the path it lives on.
#
# The rename does the work. Moving the item into a scratch directory beside it
# is one atomic operation on the same filesystem, so from the moment it
# returns the item is gone from the path the registry named, whatever becomes
# of the recursive delete afterwards. Deleting in place would leave a
# half-emptied root sitting where a full one was, which reads as success and
# is not.
#
# Returns 0 when it is gone, 1 when nothing was touched, and 2 when it is gone
# from its own path but the scratch copy beside it survived. In that last case
# the scratch path is left in $_pp_tmp, because the closing report has to name
# everything that is still on the disk.
purge_path() {
    _pp_parent=${1%/*}
    [ -n "$_pp_parent" ] || _pp_parent="/"
    _pp_tmp=$(mktemp -d "$_pp_parent/.agent-profile-removing.XXXXXX" 2>/dev/null) || return 1
    if ! mv "$1" "$_pp_tmp/" 2>/dev/null; then
        rmdir "$_pp_tmp" 2>/dev/null
        return 1
    fi
    rm -rf "$_pp_tmp" 2>/dev/null || return 2
    return 0
}

# remove_delete <path>: delete one item and say what happened.
#
# Which of purge_path's three answers this was is read back off the disk
# rather than taken on trust, because the disk is what the closing report has
# to describe. A scratch copy that outlived its delete is appended to
# $_rm_stranded so that report can name it.
remove_delete() {
    if purge_path "$1"; then
        printf 'Deleted %s\n' "$1"
        return 0
    fi

    if [ -e "$1" ]; then
        warn "could not delete $1"
        return 1
    fi

    printf 'Deleted %s\n' "$1"
    _rm_stranded="$_rm_stranded$_pp_tmp
"
}

# remove_left <label> <path> <note>: one entry of the closing list, with the
# command that deletes it. The note says why it is still there, or is empty.
remove_left() {
    printf '  %-12s %s\n' "$1" "$2"
    [ -n "${3:-}" ] && printf '  %-12s %s\n' "" "$3"
    printf '  %-12s rm -rf %s\n' "" "$(shell_quote "$2")"
    printf '\n'
}

cmd_remove() {
    need python3
    _rm_name=""
    _rm_purge=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --purge) _rm_purge=1 ;;
            -*)      die "unknown option '$1'" ;;
            *)       [ -z "$_rm_name" ] || die "unexpected argument '$1'"; _rm_name="$1" ;;
        esac
        shift
    done

    [ -n "$_rm_name" ] || die "usage: $SELF remove <profile> [--purge]"
    require_profile "$_rm_name"

    _rm_agent=$(profile_agent "$_rm_name")
    _rm_root=$(profile_root "$_rm_name")
    _rm_sessions=$(session_count "$_rm_root")
    _rm_service="$(agent_def "$_rm_agent" cred_service)-$(cred_info "$_rm_root" | cut -f2)"

    # A path the registry does not name is derived here for the report and
    # never for the deleting. Where an app data directory or a launcher would
    # conventionally be is a guess, and a guess is not something to delete.
    _rm_data=$(reg_get "$_rm_name" app_data)
    _rm_data_note=""
    if [ -z "$_rm_data" ]; then
        _rm_data="$(agent_def "$_rm_agent" app_support)/$(agent_def "$_rm_agent" app_prefix)$(capitalize "$_rm_name")"
        _rm_data_note="the registry entry did not name it, so this is the conventional path"
    fi
    _rm_applet=$(reg_get "$_rm_name" applet)
    _rm_applet_note=""
    if [ -z "$_rm_applet" ]; then
        _rm_applet=$(applet_default_path "$_rm_agent" "$_rm_name")
        _rm_applet_note="the registry entry did not name it, so this is the conventional path"
    fi

    _rm_root_block=""
    _rm_data_block=""
    _rm_applet_block=""
    _rm_stranded=""

    if [ -n "$_rm_purge" ]; then
        # No script may ever purge. The typed confirmation is the whole safety
        # mechanism here, and a prompt nobody can answer is not one.
        is_tty || die "--purge needs a terminal, and stdin here is not one.
It asks you to type the profile name back before it deletes anything, so there
was nobody to ask and nothing was removed. Run '$SELF remove $_rm_name'
without --purge to get the list of paths, and delete them yourself."

        # Work out what may be deleted before saying anything, so the list
        # that gets confirmed is the list that gets acted on. A path that is
        # not there blocks nothing: there is nothing to refuse to delete.
        if [ -e "$_rm_root" ]; then
            _rm_root_block=$(remove_blocker "$_rm_name" "$_rm_root")
        fi
        if [ -e "$_rm_data" ]; then
            if [ -n "$_rm_data_note" ]; then
                _rm_data_block="the registry entry does not name it"
            else
                _rm_data_block=$(remove_blocker "$_rm_name" "$_rm_data")
            fi
        fi
        if [ -e "$_rm_applet" ]; then
            if [ -n "$_rm_applet_note" ]; then
                _rm_applet_block="the registry entry does not name it"
            else
                _rm_applet_block=$(remove_blocker "$_rm_name" "$_rm_applet")
            fi
        fi

        printf 'Purging profile %s. This permanently deletes:\n\n' "$_rm_name"
        if [ -e "$_rm_root" ] && [ -z "$_rm_root_block" ]; then
            printf '  %-12s %s\n' "config root" "$_rm_root"
            printf '  %-12s %s session(s)\n' "" "$_rm_sessions"
        fi
        if [ -e "$_rm_data" ] && [ -z "$_rm_data_block" ]; then
            printf '  %-12s %s\n' "app data" "$_rm_data"
        fi
        if [ -e "$_rm_applet" ] && [ -z "$_rm_applet_block" ]; then
            printf '  %-12s %s\n' "launcher" "$_rm_applet"
        fi
        printf '  %-12s %s\n' "registry" "$(reg_file "$_rm_name")"
        printf '\n'

        # What will be left has to be said before the question, not after the
        # answer.
        if [ -n "$_rm_root_block$_rm_data_block$_rm_applet_block" ]; then
            printf 'Not deleted, and left exactly as it is:\n\n'
            if [ -n "$_rm_root_block" ]; then
                printf '  %-12s %s\n  %-12s %s\n' "config root" "$_rm_root" "" "$_rm_root_block"
            fi
            if [ -n "$_rm_data_block" ]; then
                printf '  %-12s %s\n  %-12s %s\n' "app data" "$_rm_data" "" "$_rm_data_block"
            fi
            if [ -n "$_rm_applet_block" ]; then
                printf '  %-12s %s\n  %-12s %s\n' "launcher" "$_rm_applet" "" "$_rm_applet_block"
            fi
            printf '\n'
        fi

        printf 'The credential is not listed above, and never will be: this tool never\n'
        printf 'touches credentials. The command that deletes it is printed at the end.\n'
        printf '\n'
        printf 'This cannot be undone. Type the profile name to confirm: '
        _rm_typed=""
        read -r _rm_typed || true
        # Exactly the name, or nothing happens at all. A prompt that takes "y"
        # is answered by anyone typing ahead without reading it.
        if [ "$_rm_typed" != "$_rm_name" ]; then
            printf '\n'
            printf 'Aborted. Nothing was deleted, and %s is still registered.\n' "$_rm_name"
            return "$EX_ERR"
        fi
        printf '\n'

        if [ -e "$_rm_root" ] && [ -z "$_rm_root_block" ]; then
            remove_delete "$_rm_root"
        fi
        if [ -e "$_rm_data" ] && [ -z "$_rm_data_block" ]; then
            remove_delete "$_rm_data"
        fi
        if [ -e "$_rm_applet" ] && [ -z "$_rm_applet_block" ]; then
            remove_delete "$_rm_applet"
        fi
        printf '\n'
    fi

    # The registry entry goes last, so a delete that fails leaves the record
    # of what belonged to whom standing until the data it describes is gone.
    _rm_file=$(reg_file "$_rm_name")
    rm -f "$_rm_file" || die "could not remove $_rm_file"
    printf 'Unregistered %s\n' "$_rm_name"
    printf '\n'

    # What is still here is tested, never assumed. A delete that failed part
    # way must not be able to leave this list saying the data is gone.
    printf 'Left on this machine:\n\n'
    _rm_left=""
    if [ -e "$_rm_root" ]; then
        _rm_note="$_rm_sessions session(s)"
        [ -n "$_rm_root_block" ] && _rm_note="$_rm_note, not deleted: $_rm_root_block"
        remove_left "config root" "$_rm_root" "$_rm_note"
        _rm_left=1
    fi
    if [ -e "$_rm_data" ]; then
        _rm_note="$_rm_data_note"
        [ -n "$_rm_data_block" ] && _rm_note="not deleted: $_rm_data_block"
        remove_left "app data" "$_rm_data" "$_rm_note"
        _rm_left=1
    fi
    if [ -e "$_rm_applet" ]; then
        _rm_note="$_rm_applet_note"
        [ -n "$_rm_applet_block" ] && _rm_note="not deleted: $_rm_applet_block"
        remove_left "launcher" "$_rm_applet" "$_rm_note"
        _rm_left=1
    fi
    if [ -n "$_rm_stranded" ]; then
        printf '%s' "$_rm_stranded" | while IFS= read -r _rm_strand; do
            [ -n "$_rm_strand" ] || continue
            remove_left "leftover" "$_rm_strand" "moved out of the way, then could not be deleted"
        done
        _rm_left=1
    fi

    printf '  %-12s %s\n' "credential" "$_rm_service"
    printf '  %-12s %s\n' "" "This tool never touches credentials, so this one is yours to delete."
    printf '  %-12s %s\n' "" "Until it is gone, doctor --keychain-scan counts it as a D12 orphan."
    if [ -n "${USER:-}" ]; then
        printf '  %-12s security delete-generic-password -s %s -a %s\n' \
            "" "$(shell_quote "$_rm_service")" "$(shell_quote "$USER")"
    else
        # shellcheck disable=SC2016  # literal help text; the reader's shell expands it
        printf '  %-12s security delete-generic-password -s %s -a "$USER"\n' \
            "" "$(shell_quote "$_rm_service")"
    fi
    printf '\n'
    if [ -z "$_rm_purge" ]; then
        # Said plainly, because the entry that named these paths is the thing
        # this command just deleted. There is no second chance to ask it.
        printf 'The registry entry is gone, so this command cannot look those paths up again.\n'
        printf 'The list above is the whole record of them.\n'
        printf '\n'
    fi
    printf 'Then run: %s doctor\n' "$SELF"
    printf 'A root no profile claims is D06 and a launcher no profile claims is D14, so\n'
    printf 'both go quiet once those paths are gone.\n'

    if [ -n "$_rm_purge" ] && [ -n "$_rm_left" ]; then
        return "$EX_ERR"
    fi
    return "$EX_OK"
}

# ---------------------------------------------------------------------------
# run, shell, env, path
# ---------------------------------------------------------------------------

cmd_run() {
    [ $# -ge 1 ] || die "usage: $SELF run <profile> [args...]"
    _run_name="$1"; shift
    require_profile "$_run_name"
    _run_agent=$(profile_agent "$_run_name")
    _run_root=$(profile_root "$_run_name")
    _run_bin=$(agent_def "$_run_agent" binary)
    [ -n "$AGENT_PROFILE_DRY_RUN" ] || command -v "$_run_bin" >/dev/null 2>&1 || \
        die "the '$_run_bin' command is not on your PATH"
    run_pinned "$_run_agent" "$_run_root" "$_run_bin" "$@"
}

cmd_shell() {
    [ $# -ge 1 ] || die "usage: $SELF shell <profile>"
    require_profile "$1"
    _sh_agent=$(profile_agent "$1")
    _sh_root=$(profile_root "$1")
    _sh_shell="${SHELL:-/bin/bash}"
    printf 'Pinned to %s. Type exit to leave.\n' "$1" >&2
    run_pinned "$_sh_agent" "$_sh_root" "$_sh_shell"
}

cmd_env() {
    [ $# -ge 1 ] || die "usage: eval \"\$($SELF env <profile>)\""
    require_profile "$1"
    _env_agent=$(profile_agent "$1")
    _env_root=$(profile_root "$1")
    printf 'export %s=%s\n' "$(agent_def "$_env_agent" envvar)" "$(shell_quote "$_env_root")"
}

cmd_path() {
    [ $# -ge 1 ] || die "usage: $SELF path <profile>"
    require_profile "$1"
    profile_root "$1"
}

# ---------------------------------------------------------------------------
# which
#
# Reports the profile the current shell is pinned to, derived from the pinned
# root rather than from anything stored. --label prints the bare label, which
# is what a shell prompt should call.
# ---------------------------------------------------------------------------

cmd_which() {
    _wh_label_only=""
    [ "${1:-}" = "--label" ] && _wh_label_only=1

    for _wh_agent in $KNOWN_AGENTS; do
        _wh_var=$(agent_def "$_wh_agent" envvar)
        eval "_wh_root=\${$_wh_var:-}"
        [ -n "$_wh_root" ] || continue

        _wh_label=$(label_for_root "$_wh_agent" "$_wh_root")
        if [ -n "$_wh_label_only" ]; then
            printf '%s\n' "$_wh_label"
            return 0
        fi

        # Name the registered profile if one claims this root, but the label
        # above is derived from the root either way.
        _wh_named=""
        for _wh_name in $(profile_names); do
            if [ "$(reg_get "$_wh_name" root)" = "$_wh_root" ]; then
                _wh_named="$_wh_name"
                break
            fi
        done

        printf 'Pinned to %s\n' "$_wh_label"
        printf '  agent     %s\n' "$_wh_agent"
        printf '  %s=%s\n' "$_wh_var" "$_wh_root"
        if [ -n "$_wh_named" ]; then
            printf '  profile   %s\n' "$_wh_named"
        else
            printf '  profile   (not registered; no registry entry claims this root)\n'
        fi
        return 0
    done

    if [ -n "$_wh_label_only" ]; then
        return 1
    fi
    printf 'Not pinned to any profile.\n'
    printf '\n'
    printf 'This shell has none of these set: '
    for _wh_agent in $KNOWN_AGENTS; do
        printf '%s ' "$(agent_def "$_wh_agent" envvar)"
    done
    printf '\n'
    printf 'Anything you run here writes to the default root, which is what %s\n' "$SELF"
    # shellcheck disable=SC2016  # literal help text; the user types this
    printf 'doctor reports as a leak. Pin with: eval "$(%s env <profile>)"\n' "$SELF"
    return 0
}

# ---------------------------------------------------------------------------
# The desktop half
#
# The desktop app takes its config root from its process environment, and
# `open --env` is what puts it there (docs/FACTS.md F01 and F13). Two routes
# that look reasonable and are not: a .app bundle whose executable is a shell
# script never launches at all (F14), and exec'ing the app binary from an
# interactive shell kills it (F15). Neither is attempted here.
#
# The launcher form that survives a reboot and a Dock click is an AppleScript
# applet, so `app` generates and repairs one with osacompile rather than
# assembling a bundle by hand.
# ---------------------------------------------------------------------------

# applet_script_path <applet>: where an applet keeps its compiled source.
applet_script_path() {
    printf '%s\n' "$1/Contents/Resources/Scripts/main.scpt"
}

# applet_safe_path <label> <path>
#
# The launch line nests a shell command inside an AppleScript string literal,
# so a path carrying a quote, a backslash, a dollar or a backtick would have to
# survive two layers of quoting intact. Refuse rather than escape: these are
# directories under $HOME, and a launcher that is subtly wrong is worse than
# one that will not be built.
applet_safe_path() {
    # A literal newline, because a case pattern cannot spell one any other way.
    _asp_nl='
'
    case "$2" in
        *[\"\\\$\`]*|*"$_asp_nl"*)
            die "$1 contains a character the launch line cannot carry safely: $2
The applet nests a shell command inside an AppleScript string, so a quote,
backslash, dollar or backtick in this path would need to survive two layers of
quoting. Choose a path without them." ;;
    esac
}

# applet_default_path <agent> <name>
applet_default_path() {
    printf '%s/%s%s.app\n' \
        "$AGENT_PROFILE_APPS_DIR" "$(agent_def "$1" applet_prefix)" "$(capitalize "$2")"
}

# profile_applet <name> <agent>: the registered applet, or the default path.
# reg_get returns empty for a key that is not there, so entries written before
# applet= existed keep working.
profile_applet() {
    _pa_stored=$(reg_get "$1" applet)
    if [ -n "$_pa_stored" ]; then
        printf '%s\n' "$_pa_stored"
    else
        applet_default_path "$2" "$1"
    fi
}

# leak_test_glob <agent>: the glob the leak test must use to see every root.
#
# It has to be built from the default root, not from root_prefix. The prefix is
# ".claude-", whose glob ".claude-*" silently excludes "~/.claude" itself, and
# the default root is the single most important place to look: it is where
# everything unpinned lands. A leak test that cannot see a leak is worse than
# no leak test.
leak_test_glob() {
    _ltg_default=$(agent_def "$1" default_root)
    printf '%s*\n' "${_ltg_default##*/}"
}

# applet_scan <agent>: every applet on this machine that pins this agent.
#
# Emits one absolute path per line, sorted, or nothing. A bundle qualifies only
# when it holds a compiled script whose launch line mentions the agent's
# variable, which is what keeps the machine's other AppleScript apps out of the
# results without needing a naming convention.
#
# The depth is load bearing. A script sits five levels below the search
# directory, at X.app/Contents/Resources/Scripts/main.scpt, and a -maxdepth 4
# finds nothing at all while looking like a clean result. That mistake has
# already been made once here, against a real machine, so the depth is pinned
# in a test rather than trusted to this comment.
applet_scan() {
    command -v osadecompile >/dev/null 2>&1 || return 0
    _as_var=$(agent_def "$1" envvar)

    printf '%s\n' "$AGENT_PROFILE_APPLET_DIRS" | tr ':' '\n' | while IFS= read -r _as_dir; do
        [ -n "$_as_dir" ] || continue
        [ -d "$_as_dir" ] || continue
        find "$_as_dir" -maxdepth 5 -path '*/Contents/Resources/Scripts/main.scpt' 2>/dev/null
    done | while IFS= read -r _as_script; do
        [ -n "$_as_script" ] || continue
        # Strip the four trailing path components back to the bundle.
        _as_app=${_as_script%/Contents/Resources/Scripts/main.scpt}
        case "$(applet_current_line "$_as_app")" in
            *"$_as_var="*) printf '%s\n' "$_as_app" ;;
        esac
    done | sort -u
}

# applet_pinned_root <agent> <applet>: the root an applet pins, or empty.
applet_pinned_root() {
    _apr_var=$(agent_def "$1" envvar)
    _apr_line=$(applet_current_line "$2")
    # Anchored on " --args" so a root containing spaces still comes back whole.
    printf '%s' "$_apr_line" | sed -n "s/.*$_apr_var=\(.*\) --args.*/\1/p"
}

# reg_set <name> <key> <value>: replace one key, leave every other one alone.
reg_set() {
    _rset_file=$(reg_file "$1")
    [ -f "$_rset_file" ] || die "profile '$1' has no registry entry"
    _rset_tmp=$(mktemp "$_rset_file.tmp.XXXXXX") || die "could not create a temporary file beside $_rset_file"
    {
        grep -v "^$2=" "$_rset_file" || true
        printf '%s=%s\n' "$2" "$3"
    } > "$_rset_tmp" || die "could not write $_rset_tmp"
    mv "$_rset_tmp" "$_rset_file" || die "could not update $_rset_file"
}

# applet_launch_line <bundle> <var> <root> <flag> <app-data>
#
# The verified form, verbatim from docs/FACTS.md F13. --env before --args,
# because everything after --args goes to the application rather than to open.
applet_launch_line() {
    printf 'do shell script "open -n -a \\"%s\\" --env \\"%s=%s\\" --args %s=\\"%s\\" > /dev/null 2>&1 &"\n' \
        "$1" "$2" "$3" "$4" "$5"
}

# applet_line_norm: read a launch line on stdin, emit it without quoting.
#
# osadecompile is free to re-spell AppleScript's string escapes, so every
# comparison happens with the quoting stripped out. What is being compared is
# the command, not its spelling.
applet_line_norm() {
    sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' | tr -d '\\"'
}

# applet_current_line <applet>: the applet's launch line, normalised, or empty.
applet_current_line() {
    command -v osadecompile >/dev/null 2>&1 || return 0
    osadecompile "$(applet_script_path "$1")" 2>/dev/null \
        | sed -n 's/^[[:space:]]*//; /^do shell script /p' \
        | head -1 \
        | applet_line_norm
}

# applet_verdict <applet> <bundle> <var> <root> <flag> <app-data>
#
# One definition of "this applet is correct", used by both `app` and doctor's
# D13, so the audit and the repair can never disagree about what correct means.
#
# Emits one word:
#   ok          the launch line is exactly right
#   no-applet   there is no applet at that path
#   no-script   the bundle has no compiled script (not an applet)
#   unreadable  osadecompile is missing or would not read it
#   no-line     the script has no do-shell-script line
#   nopin       it launches the app without pinning anything
#   badorder    --env sits after --args, so open hands it to the app instead
#   wrongroot   it pins a root other than this profile's
#   wrongdata   it selects a different app data directory
#   differs     right root and right data dir, but not the generated form
applet_verdict() {
    _av_applet="$1"; _av_bundle="$2"; _av_var="$3"
    _av_root="$4"; _av_flag="$5"; _av_data="$6"

    [ -d "$_av_applet" ] || { printf 'no-applet\n'; return 0; }
    [ -f "$(applet_script_path "$_av_applet")" ] || { printf 'no-script\n'; return 0; }
    command -v osadecompile >/dev/null 2>&1 || { printf 'unreadable\n'; return 0; }

    _av_have=$(applet_current_line "$_av_applet")
    [ -n "$_av_have" ] || { printf 'no-line\n'; return 0; }

    _av_want=$(applet_launch_line "$_av_bundle" "$_av_var" "$_av_root" "$_av_flag" "$_av_data" \
        | applet_line_norm)
    [ "$_av_have" = "$_av_want" ] && { printf 'ok\n'; return 0; }

    case "$_av_have" in
        *"--env $_av_var="*) ;;
        *) printf 'nopin\n'; return 0 ;;
    esac

    # Everything after --args belongs to the application, so an --env that only
    # appears there is not a pin at all, however right it looks.
    case "${_av_have%%--args*}" in
        *"--env $_av_var="*) ;;
        *) printf 'badorder\n'; return 0 ;;
    esac

    case "$_av_have" in
        *"--env $_av_var=$_av_root --args"*) ;;
        *) printf 'wrongroot\n'; return 0 ;;
    esac

    case "$_av_have" in
        *"$_av_flag=$_av_data "*) ;;
        *) printf 'wrongdata\n'; return 0 ;;
    esac

    printf 'differs\n'
}

# applet_verdict_says <verdict>: one sentence, shared by `app` and D13.
applet_verdict_says() {
    case "$1" in
        nopin)      printf 'it launches the app with nothing pinned, so its sessions write to the default root' ;;
        badorder)   printf 'its --env comes after --args, so open passes it to the app instead of setting it' ;;
        wrongroot)  printf 'it pins a different config root from the one this profile owns' ;;
        wrongdata)  printf 'it selects a different app data directory, so the app signs in as someone else' ;;
        no-line)    printf 'its script has no launch line at all' ;;
        no-script)  printf 'it is not an AppleScript applet: there is no compiled script inside it' ;;
        differs)    printf 'its launch line is not the generated form' ;;
        *)          printf 'it is %s' "$1" ;;
    esac
}

# applet_write <applet> <profile> <launch-line>
#
# Creates the applet if it is not there. If it is, only the compiled script is
# replaced, by moving it in from a scratch applet, so an icon and any other
# bundle contents survive being repaired.
applet_write() {
    _aw_applet="$1"; _aw_name="$2"; _aw_line="$3"
    need osacompile

    if [ ! -d "$_aw_applet" ]; then
        mkdir -p "$(dirname "$_aw_applet")" || die "could not create $(dirname "$_aw_applet")"
        osacompile \
            -e "-- agent-profile: launches the desktop app pinned to profile \"$_aw_name\"." \
            -e "-- Generated. To change or repair it: $SELF app $_aw_name" \
            -e "-- Why open --env and not a wrapper script: docs/FACTS.md F13, F14, F15." \
            -e "$_aw_line" \
            -o "$_aw_applet" || die "osacompile could not create $_aw_applet"
        printf 'Created %s\n' "$_aw_applet"
        return 0
    fi

    [ -f "$(applet_script_path "$_aw_applet")" ] || \
        die "$_aw_applet exists but is not an AppleScript applet: no compiled script inside it.
Refusing to overwrite it. Remove it, or pass --applet with another path."

    # Every temporary path here comes from mktemp. A name built from $$ is
    # guessable, and under a shared TMPDIR that is a symlink race, so the
    # test suite refuses the $$ form outright.
    _aw_tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-profile-applet.XXXXXX") || \
        die "could not create a temporary directory under ${TMPDIR:-/tmp}"
    osacompile \
        -e "-- agent-profile: launches the desktop app pinned to profile \"$_aw_name\"." \
        -e "-- Generated. To change or repair it: $SELF app $_aw_name" \
        -e "-- Why open --env and not a wrapper script: docs/FACTS.md F13, F14, F15." \
        -e "$_aw_line" \
        -o "$_aw_tmp/applet.app" || { rm -rf "$_aw_tmp"; die "osacompile failed"; }

    if ! mv "$_aw_tmp/applet.app/Contents/Resources/Scripts/main.scpt" \
            "$(applet_script_path "$_aw_applet")"; then
        rm -rf "$_aw_tmp"
        die "could not replace the script inside $_aw_applet"
    fi
    rm -rf "$_aw_tmp"
    printf 'Repaired the launch line in %s\n' "$_aw_applet"
}

# applet_set_icon <applet> <png>
#
# The stock recipe: sips for every size the Dock asks for, iconutil to pack
# them. The original is kept once, and only once: a second run must not
# overwrite the real original with something this tool generated.
applet_set_icon() {
    _ai_applet="$1"; _ai_png="$2"
    need sips
    need iconutil
    [ -f "$_ai_png" ] || die "no such image: $_ai_png"
    [ -d "$_ai_applet/Contents/Resources" ] || die "$_ai_applet has no Resources directory"

    _ai_tmp=$(mktemp -d "${TMPDIR:-/tmp}/agent-profile-icon.XXXXXX") || \
        die "could not create a temporary directory under ${TMPDIR:-/tmp}"
    mkdir -p "$_ai_tmp/icon.iconset" || die "could not create $_ai_tmp/icon.iconset"

    for _ai_s in 16 32 128 256 512; do
        sips -z "$_ai_s" "$_ai_s" "$_ai_png" \
            --out "$_ai_tmp/icon.iconset/icon_${_ai_s}x${_ai_s}.png" >/dev/null 2>&1 || \
            { rm -rf "$_ai_tmp"; die "sips could not resize $_ai_png to ${_ai_s}px"; }
        _ai_d=$((_ai_s * 2))
        sips -z "$_ai_d" "$_ai_d" "$_ai_png" \
            --out "$_ai_tmp/icon.iconset/icon_${_ai_s}x${_ai_s}@2x.png" >/dev/null 2>&1 || \
            { rm -rf "$_ai_tmp"; die "sips could not resize $_ai_png to ${_ai_d}px"; }
    done

    iconutil -c icns "$_ai_tmp/icon.iconset" -o "$_ai_tmp/applet.icns" || \
        { rm -rf "$_ai_tmp"; die "iconutil could not build an icns from $_ai_png"; }

    _ai_dest="$_ai_applet/Contents/Resources/applet.icns"
    if [ -f "$_ai_dest" ] && [ ! -f "$_ai_dest.orig" ]; then
        mv "$_ai_dest" "$_ai_dest.orig" || { rm -rf "$_ai_tmp"; die "could not back up $_ai_dest"; }
        printf 'Kept the original icon as %s\n' "$_ai_dest.orig"
    fi
    mv "$_ai_tmp/applet.icns" "$_ai_dest" || { rm -rf "$_ai_tmp"; die "could not install the icon"; }
    rm -rf "$_ai_tmp"
    touch "$_ai_applet"

    printf 'Set the icon on %s\n' "$_ai_applet"
    printf '\n'
    printf 'The Dock caches icons. If it still shows the old one, drag the applet out of\n'
    printf 'the Dock and back in; killall Dock if that is not enough.\n'
    printf 'At Dock size a word is illegible. One large initial and a distinct colour per\n'
    printf 'account is what actually reads.\n'
}

# ---------------------------------------------------------------------------
# desktop
# ---------------------------------------------------------------------------

cmd_desktop() {
    [ $# -ge 1 ] || die "usage: $SELF desktop <profile> [open args...]"
    _dk_name="$1"; shift
    require_profile "$_dk_name"
    _dk_agent=$(profile_agent "$_dk_name")
    _dk_root=$(profile_root "$_dk_name")
    _dk_data=$(reg_get "$_dk_name" app_data)
    [ -n "$_dk_data" ] || _dk_data="$(agent_def "$_dk_agent" app_support)/$(agent_def "$_dk_agent" app_prefix)$(capitalize "$_dk_name")"

    if [ -z "$AGENT_PROFILE_DRY_RUN" ]; then
        _dk_bundle=$(agent_def "$_dk_agent" app_bundle)
        [ -d "$_dk_bundle" ] || die "the desktop app is not installed at $_dk_bundle"
        command -v open >/dev/null 2>&1 || die "the 'open' command is not on your PATH (this command is macOS only)"
        open_supports_env || die "this open(1) does not support --env, so the app cannot be pinned.
Launching it anyway would start an unpinned session writing to the default
root, which is the leak this tool exists to prevent, so nothing was launched.
See docs/FACTS.md F13."
    fi

    open_pinned "$_dk_agent" "$_dk_root" "$_dk_data" "$@"
}

# ---------------------------------------------------------------------------
# code, idea
#
# Launch an IDE with a profile pinned. The only supported way to start an IDE
# whose Claude Code extension is not writing to the default root, because the
# pin has to be in the IDE's process environment and open --env is what puts it
# there (docs/FACTS.md F19, and F13 for the mechanism).
#
# `code` covers the VS Code family, `idea` the JetBrains family, and --app
# names a different application in either: --app Cursor, --app PyCharm. There
# is no list of blessed applications, because the mechanism does not care which
# one it is, and a tool that refuses to launch PyCharm because nobody added it
# to a list is worse than one that hands the name to open.
# ---------------------------------------------------------------------------

cmd_ide() {
    _ci_cmd="$1"; shift
    _ci_app=""
    _ci_name=""
    _ci_path=""
    _ci_have_path=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --app) shift; [ $# -gt 0 ] || die "--app needs a value"; _ci_app="$1" ;;
            -*)    die "unknown option '$1'
Try: $SELF $_ci_cmd <profile> [path] [--app NAME]" ;;
            *)
                if [ -z "$_ci_name" ]; then
                    _ci_name="$1"
                elif [ -z "$_ci_have_path" ]; then
                    _ci_path="$1"; _ci_have_path=1
                else
                    die "unexpected argument '$1'
Try: $SELF $_ci_cmd <profile> [path] [--app NAME]"
                fi
                ;;
        esac
        shift
    done

    [ -n "$_ci_name" ] || die "usage: $SELF $_ci_cmd <profile> [path] [--app NAME]"
    require_profile "$_ci_name"
    _ci_agent=$(profile_agent "$_ci_name")
    _ci_root=$(profile_root "$_ci_name")

    # The default application is the first IDE this subcommand covers, read
    # from the seam rather than written here, so a family's default and the
    # rule that audits that family come from one place.
    if [ -z "$_ci_app" ]; then
        _ci_first=$(ides_for_command "$_ci_cmd" | head -1)
        [ -n "$_ci_first" ] || die "internal: no IDE is registered for '$_ci_cmd'"
        _ci_app=$(ide_def "$_ci_first" app)
    fi

    if [ -z "$AGENT_PROFILE_DRY_RUN" ]; then
        command -v open >/dev/null 2>&1 || die "the 'open' command is not on your PATH (this command is macOS only)"
        open_supports_env || die "this open(1) does not support --env, so the IDE cannot be pinned.
Launching it anyway would start an IDE whose Claude Code extension writes to
the default root, which is the leak this tool exists to prevent, so nothing was
launched. See docs/FACTS.md F13 and F19."
    fi

    # The application is not checked for on disk. open resolves a name through
    # LaunchServices, so an IDE installed anywhere but /Applications would fail
    # a path check while open would have found it. A name that resolves to
    # nothing fails in open, with open's own message.
    if [ -n "$_ci_have_path" ]; then
        open_ide "$_ci_agent" "$_ci_root" "$_ci_app" "$_ci_path"
    else
        open_ide "$_ci_agent" "$_ci_root" "$_ci_app"
    fi
}

# ---------------------------------------------------------------------------
# app
#
# Generate or repair the AppleScript applet that launches a profile from the
# Dock. Idempotent, and it says which of the two happened: an already-correct
# applet and one that was never built must not look the same from here.
# ---------------------------------------------------------------------------

cmd_app() {
    _ap_name=""
    _ap_applet=""
    _ap_icon=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --applet) shift; [ $# -gt 0 ] || die "--applet needs a value"; _ap_applet="$1" ;;
            --icon)   shift; [ $# -gt 0 ] || die "--icon needs a value"; _ap_icon="$1" ;;
            -*)       die "unknown option '$1'" ;;
            *)        [ -z "$_ap_name" ] || die "unexpected argument '$1'"; _ap_name="$1" ;;
        esac
        shift
    done

    [ -n "$_ap_name" ] || die "usage: $SELF app <profile> [--applet PATH] [--icon PNG]"
    require_profile "$_ap_name"
    _ap_agent=$(profile_agent "$_ap_name")
    _ap_root=$(profile_root "$_ap_name")
    _ap_data=$(reg_get "$_ap_name" app_data)
    [ -n "$_ap_data" ] || _ap_data="$(agent_def "$_ap_agent" app_support)/$(agent_def "$_ap_agent" app_prefix)$(capitalize "$_ap_name")"

    # Resolving which applet this profile means, in strict order:
    #   1. --applet, which always wins. Explicit beats inferred.
    #   2. the registry, if a previous run recorded one.
    #   3. a launcher already on this machine that pins this profile's root.
    #   4. the conventional path, as before.
    #
    # Step 3 exists because the conventional path was wrong on the first real
    # machine this met: the working launchers were on the Desktop. Without it,
    # `app tide` builds a second applet beside a working one and leaves the
    # working one unaudited, which is worse than doing nothing.
    _ap_found=""
    if [ -z "$_ap_applet" ]; then
        _ap_applet=$(reg_get "$_ap_name" applet)
    fi
    if [ -z "$_ap_applet" ]; then
        _ap_scan=$(mktemp "${TMPDIR:-/tmp}/agent-profile-app.XXXXXX") || \
            die "could not create a temporary file under ${TMPDIR:-/tmp}"
        applet_scan "$_ap_agent" 2>/dev/null | while IFS= read -r _ap_cand; do
            [ -n "$_ap_cand" ] || continue
            [ "$(applet_pinned_root "$_ap_agent" "$_ap_cand")" = "$_ap_root" ] && \
                printf '%s\n' "$_ap_cand"
        done > "$_ap_scan"
        _ap_hits=$(grep -c '' < "$_ap_scan")

        if [ "$_ap_hits" -eq 1 ]; then
            _ap_applet=$(cat "$_ap_scan")
            _ap_found=1
        elif [ "$_ap_hits" -gt 1 ]; then
            _ap_list=$(sed 's/^/  /' "$_ap_scan")
            rm -f "$_ap_scan"
            die "$_ap_hits launchers already pin profile '$_ap_name':

$_ap_list

Refusing to guess which one is canonical, because repairing the wrong one
rewrites a file you did not name. Say which with --applet, and remove or
re-point the other so doctor stops reporting it as D14."
        fi
        rm -f "$_ap_scan"
    fi
    [ -n "$_ap_applet" ] || _ap_applet=$(applet_default_path "$_ap_agent" "$_ap_name")
    case "$_ap_applet" in
        /*) ;;
        *)  die "--applet must be an absolute path. Got: $_ap_applet" ;;
    esac
    _ap_applet=$(canonical_path "$_ap_applet")

    _ap_bundle=$(agent_def "$_ap_agent" app_bundle)
    _ap_var=$(agent_def "$_ap_agent" envvar)
    _ap_flag=$(agent_def "$_ap_agent" app_flag)

    applet_safe_path "the config root" "$_ap_root"
    applet_safe_path "the app data directory" "$_ap_data"
    applet_safe_path "the app bundle path" "$_ap_bundle"

    _ap_line=$(applet_launch_line "$_ap_bundle" "$_ap_var" "$_ap_root" "$_ap_flag" "$_ap_data")
    _ap_verdict=$(applet_verdict "$_ap_applet" "$_ap_bundle" "$_ap_var" "$_ap_root" "$_ap_flag" "$_ap_data")

    if [ -n "$_ap_found" ]; then
        printf 'Found an existing launcher for %s and adopted it:\n' "$_ap_name"
        printf '  %s\n' "$_ap_applet"
        printf 'It was not created just now, and it is not at the conventional path.\n'
        printf '\n'
    fi

    case "$_ap_verdict" in
        ok)
            printf '%s is already correct.\n' "$_ap_applet"
            printf '  pins      %s=%s\n' "$_ap_var" "$_ap_root"
            printf '  app data  %s\n' "$_ap_data"
            printf 'Nothing to do. This is what an applied change looks like on a second run;\n'
            printf 'it is not the same as one that never worked.\n'
            ;;
        unreadable)
            die "cannot read $_ap_applet: osadecompile is not available.
Without it there is no way to tell a correct applet from a broken one, and
overwriting one blind could replace a launcher you edited by hand."
            ;;
        no-applet)
            applet_write "$_ap_applet" "$_ap_name" "$_ap_line"
            printf '  pins      %s=%s\n' "$_ap_var" "$_ap_root"
            printf '  app data  %s\n' "$_ap_data"
            ;;
        *)
            printf 'Repairing %s: %s.\n' "$_ap_applet" "$(applet_verdict_says "$_ap_verdict")"
            applet_write "$_ap_applet" "$_ap_name" "$_ap_line"
            printf '  pins      %s=%s\n' "$_ap_var" "$_ap_root"
            printf '  app data  %s\n' "$_ap_data"
            ;;
    esac

    _ap_stored=$(reg_get "$_ap_name" applet)
    if [ "$_ap_stored" != "$_ap_applet" ]; then
        reg_set "$_ap_name" applet "$_ap_applet"
    fi

    if [ -n "$_ap_icon" ]; then
        printf '\n'
        applet_set_icon "$_ap_applet" "$_ap_icon"
    fi

    printf '\n'
    printf 'Confirm it actually pins, by starting a Code session in the app and running:\n'
    # shellcheck disable=SC2016  # literal help text; the user types this
    printf '  find "$HOME"/%s -name "*.jsonl" -mmin -3\n' "$(leak_test_glob "$_ap_agent")"
    printf 'The path it prints is the root that is really in use.\n'
}

# ---------------------------------------------------------------------------
# Project paths
#
# Claude Code names a project directory after the working directory with every
# non-alphanumeric character replaced by "-", truncating and hashing past 200
# characters, and CLAUDE_CODE_PROJECT_DIR_NAME can override the name outright.
# That encoding is not reversible, so never try. Each transcript records its
# own cwd as an absolute path; read that instead.
#
# One python3 pass over every root, stopping at the first record that carries a
# cwd in each transcript.
# ---------------------------------------------------------------------------

# read_project_cwds <root>...
# Emits: root<TAB>cwd
read_project_cwds() {
    python3 - "$@" <<'PY'
import json, os, sys

for root in sys.argv[1:]:
    projects = os.path.join(root, "projects")
    if not os.path.isdir(projects):
        continue
    for dirpath, _dirnames, filenames in os.walk(projects):
        for name in filenames:
            if not name.endswith(".jsonl"):
                continue
            try:
                with open(os.path.join(dirpath, name), errors="replace") as fh:
                    for line in fh:
                        if '"cwd"' not in line:
                            continue
                        try:
                            record = json.loads(line)
                        except ValueError:
                            continue
                        cwd = record.get("cwd")
                        if cwd:
                            print("\t".join([root, cwd]))
                            break
            except OSError:
                continue
PY
}

# dir_mode <path>: BSD stat on macOS, GNU stat elsewhere.
#
# Cannot be a plain "try one, fall back on failure": GNU stat -f succeeds and
# reports the filesystem rather than failing, so check the shape of the answer.
dir_mode() {
    _dm=$(stat -f '%Lp' "$1" 2>/dev/null)
    case "$_dm" in
        ''|*[!0-9]*) _dm=$(stat -c '%a' "$1" 2>/dev/null) ;;
    esac
    case "$_dm" in
        ''|*[!0-9]*) _dm="" ;;
    esac
    printf '%s\n' "$_dm"
}

# ---------------------------------------------------------------------------
# doctor
#
# The isolation audit. Every finding names the offender and the rule that found
# it. Exits EX_FINDINGS when anything is found, so this is usable from cron or
# a shell hook.
# ---------------------------------------------------------------------------

DOCTOR_FINDINGS=0

# finding <rule> <summary> <subject> [detail...]
#
# The subject is the offender itself, the path or the service name a reader
# has to look at. It is kept apart from the detail lines because a consumer of
# the JSON document needs to act on it, while the prose renders the two the
# same way it always has.
finding() {
    DOCTOR_FINDINGS=$((DOCTOR_FINDINGS + 1))
    _f_rule="$1"; _f_summary="$2"; shift 2
    if [ $# -gt 0 ]; then
        _f_subject="$1"; shift
    else
        _f_subject=""
    fi
    emit normal finding "$_f_rule" "$_f_summary" "$_f_subject" "$@"
}

# doctor_rule_catalog: every rule this audit can report, and what it looks for.
#
# The document lists all of them with a status each, so a report says what was
# checked rather than only what failed, and a rule that could not run says so
# instead of passing quietly. Fields are separated by a tab.
doctor_rule_catalog() {
    printf '%s\n' \
        "D01	The default root holds sessions, so something ran unpinned" \
        "D02	A stray state file sits outside every profile root" \
        "D03	The same project has sessions under more than one root" \
        "D04	A registered root does not exist" \
        "D05	A root has no credential and no signed-in account" \
        "D06	A config root exists that no profile claims" \
        "D07	A root or app data directory is not mode 700" \
        "D08	A project directory is not an encoded path" \
        "D09	A deep-link handler is installed and cannot be pinned" \
        "D10	A stored root is not in the form its credential is keyed on" \
        "D11	A credential exists for the default root, so something ran pinned to it" \
        "D12	Keychain credential entries belong to no known root" \
        "D13	A desktop launcher does not pin its profile" \
        "D14	A desktop launcher exists that no profile claims" \
        "D15	More than one profile is registered at the same root" \
        "D16	A Claude Code IDE extension is installed and cannot be pinned"
}

cmd_doctor() {
    _doc_keychain_scan=""
    _doc_report=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --keychain-scan) _doc_keychain_scan=1 ;;
            --json) REPORT_FORMAT=json ;;
            --report)
                shift
                [ $# -gt 0 ] || die "--report needs a file"
                _doc_report="$1"
                ;;
            *) die "doctor: unknown option '$1'
Try: $SELF doctor [--json] [--report FILE] [--keychain-scan]" ;;
        esac
        shift
    done

    # The two files are written side by side, so the argument names the pair
    # rather than one of them. Accepting either extension and dropping it stops
    # --report audit.json producing audit.json.json.
    if [ -n "$_doc_report" ]; then
        case "$_doc_report" in
            *.json) _doc_report=${_doc_report%.json} ;;
            *.md)   _doc_report=${_doc_report%.md} ;;
        esac
        REPORT_PATH="$_doc_report"
    fi

    need python3
    DOCTOR_FINDINGS=0
    _doc_names=$(profile_names)

    if [ "$REPORT_FORMAT" != "text" ] || [ -n "$REPORT_PATH" ]; then
        report_open doctor
        doctor_rule_catalog | while IFS="$(printf '\t')" read -r _doc_rule _doc_title; do
            [ -n "$_doc_rule" ] || continue
            emit data rule_catalog "$_doc_rule" "$_doc_title"
        done
        emit_profiles data
    fi

    # ---- D04, D05, D07, D08: per registered profile -----------------------
    _doc_roots=()
    for _doc_name in $_doc_names; do
        _doc_agent=$(profile_agent "$_doc_name")
        _doc_root=$(profile_root "$_doc_name")

        if [ ! -d "$_doc_root" ]; then
            finding "D04" "profile '$_doc_name' has a registered root that does not exist" \
                "$_doc_root" \
                "Either the root was moved or deleted, or the registry entry is wrong." \
                "Moving a root invalidates its login, so recreate rather than repoint."
            continue
        fi

        _doc_roots[${#_doc_roots[@]}]="$_doc_root"

        _doc_mode=$(dir_mode "$_doc_root")
        if [ -n "$_doc_mode" ] && [ "$_doc_mode" != "700" ]; then
            finding "D07" "profile '$_doc_name' root is mode $_doc_mode, not 700" \
                "$_doc_root" \
                "Fix with: chmod 700 '$_doc_root'"
        fi

        # The app data directory is held to the same standard. It carries the
        # desktop app's own login (docs/FACTS.md F18) and its embedded copy of
        # the agent (F17), so a world-readable one exposes as much as a root.
        _doc_data_dir=$(reg_get "$_doc_name" app_data)
        if [ -n "$_doc_data_dir" ] && [ -d "$_doc_data_dir" ]; then
            _doc_dmode=$(dir_mode "$_doc_data_dir")
            if [ -n "$_doc_dmode" ] && [ "$_doc_dmode" != "700" ]; then
                finding "D07" "profile '$_doc_name' app data directory is mode $_doc_dmode, not 700" \
                    "$_doc_data_dir" \
                    "It holds the desktop app's own login and its embedded agent." \
                    "Fix with: chmod 700 '$_doc_data_dir'"
            fi
        fi

        # D05 and D10. The credential check is exact now that the Keychain
        # naming is known (docs/FACTS.md F03), so a missing credential is a
        # real finding rather than a guess.
        _doc_info=$(cred_info "$_doc_root")
        _doc_hash=$(printf '%s' "$_doc_info" | cut -f2)
        _doc_form=$(printf '%s' "$_doc_info" | cut -f3)
        _doc_service="$(agent_def "$_doc_agent" cred_service)-$_doc_hash"

        if [ "$_doc_form" != "ok" ]; then
            finding "D10" "profile '$_doc_name' has a root that is not in canonical form ($_doc_form)" \
                "$_doc_root" \
                "The credential is keyed on this literal string, not on a resolved path," \
                "so this root and its canonical spelling are two different logins." \
                "Recreate the profile with the canonical path."
        fi

        if keychain_available; then
            if ! keychain_has "$_doc_service" && [ ! -f "$_doc_root/.credentials.json" ]; then
                finding "D05" "profile '$_doc_name' has no credential" \
                    "$_doc_root" \
                    "No Keychain entry '$_doc_service' and no .credentials.json." \
                    "Sign in with: $SELF run $_doc_name"
            fi
        elif [ ! -f "$_doc_root/.credentials.json" ]; then
            # No Keychain to ask, so fall back to whether an account is on
            # record and say plainly that the check was weaker.
            _doc_acct=$(read_accounts "$(agent_def "$_doc_agent" state_base)" "$_doc_root" | cut -f2)
            if [ -z "$_doc_acct" ] || [ "$_doc_acct" = "<unreadable>" ]; then
                finding "D05" "profile '$_doc_name' has no credential and no signed-in account" \
                    "$_doc_root" \
                    "No .credentials.json and no account on record." \
                    "There is no Keychain on this system, so this check is weaker than on macOS." \
                    "Sign in with: $SELF run $_doc_name"
            fi
        fi

        # D08. An encoded project directory always begins with "-", because the
        # working directory is absolute and "/" encodes to "-". Anything else
        # means CLAUDE_CODE_PROJECT_DIR_NAME named it, so nothing about the name
        # says where the project is.
        if [ -d "$_doc_root/projects" ]; then
            for _doc_pdir in "$_doc_root/projects"/*; do
                [ -d "$_doc_pdir" ] || continue
                _doc_pbase=${_doc_pdir##*/}
                case "$_doc_pbase" in
                    -*) ;;
                    *)  finding "D08" "profile '$_doc_name' has a project directory that is not an encoded path" \
                            "$_doc_pdir" \
                            "CLAUDE_CODE_PROJECT_DIR_NAME was probably used for this session." \
                            "Nothing is wrong with the data, but the directory name says nothing" \
                            "about where the project lives. The cwd checks below still hold." ;;
                esac
            done
        fi

        # D13. The applet that launches this profile from the Dock, if there
        # is one. An applet is the desktop's only tell: the app renders no
        # status line (docs/FACTS.md F16) and its own login can be correct
        # while its sessions write elsewhere (F18), so the launch line is the
        # thing to read.
        #
        # Only real isolation problems are reported. "differs" means a
        # hand-tuned launch line that still pins the right root, which is
        # nobody's business but its owner's, and "unreadable" is a question
        # for verify rather than a finding here.
        _doc_applet=$(profile_applet "$_doc_name" "$_doc_agent")
        _doc_data=$(reg_get "$_doc_name" app_data)
        [ -n "$_doc_data" ] || _doc_data="$(agent_def "$_doc_agent" app_support)/$(agent_def "$_doc_agent" app_prefix)$(capitalize "$_doc_name")"
        _doc_verdict=$(applet_verdict "$_doc_applet" \
            "$(agent_def "$_doc_agent" app_bundle)" \
            "$(agent_def "$_doc_agent" envvar)" \
            "$_doc_root" \
            "$(agent_def "$_doc_agent" app_flag)" \
            "$_doc_data")
        case "$_doc_verdict" in
            nopin|badorder|wrongroot|wrongdata|no-line|no-script)
                finding "D13" "profile '$_doc_name' has a desktop launcher that does not pin it" \
                    "$_doc_applet" \
                    "$(applet_verdict_says "$_doc_verdict")." \
                    "The desktop app takes its config root from its process environment," \
                    "and open --env is what puts it there. Note that the app's own login" \
                    "can be right while its sessions write somewhere else entirely." \
                    "Fix with: $SELF app $_doc_name" ;;
        esac
    done

    # ---- D01, D02: something ran unpinned ---------------------------------
    for _doc_agent in $KNOWN_AGENTS; do
        _doc_default=$(agent_def "$_doc_agent" default_root)
        _doc_claimed=""
        for _doc_name in $_doc_names; do
            [ "$(reg_get "$_doc_name" root)" = "$_doc_default" ] && _doc_claimed="$_doc_name"
        done

        if [ -d "$_doc_default" ] && [ -z "$_doc_claimed" ]; then
            _doc_sessions=$(session_count "$_doc_default")
            if [ "$_doc_sessions" -gt 0 ]; then
                finding "D01" "the default $_doc_agent root holds $_doc_sessions session(s)" \
                    "$_doc_default" \
                    "Something ran without a profile pinned and wrote here." \
                    "Note that pinning to the default root is not the same as not pinning:" \
                    "the state file moves inside the root when the variable is set."
            fi
        fi

        # D02 asks one question: does the unpinned state file sit outside every
        # profile root? Whether some profile claims the default root is a
        # different question and was the wrong guard. The state file lives
        # beside the default root, never inside it, so claiming that root does
        # not make this file legitimate. On the first real machine this ran on,
        # the wrong guard hid a 104 KB state file holding an account none of
        # the three profiles owns.
        _doc_state=$(agent_def "$_doc_agent" state_file)
        _doc_inside=""
        for _doc_name in $_doc_names; do
            _doc_r=$(reg_get "$_doc_name" root)
            [ -n "$_doc_r" ] || continue
            case "$_doc_state" in
                "$_doc_r"/*) _doc_inside=1 ;;
            esac
        done
        if [ -f "$_doc_state" ] && [ -n "$_doc_names" ] && [ -z "$_doc_inside" ]; then
            # Name the account, because "some file exists" is much less useful
            # than "this file belongs to an account you did not expect".
            _doc_stray_acct=$(read_accounts "$(agent_def "$_doc_agent" state_base)" "$HOME" | cut -f2)
            finding "D02" "a stray $_doc_agent state file sits outside every profile root" \
                "$_doc_state" \
                "account: ${_doc_stray_acct:-(none recorded)}" \
                "This file is written when nothing is pinned. It holds an account," \
                "per-project trust decisions and personal MCP servers for whichever" \
                "account last ran unpinned, which need not be any profile here."
        fi
    done

    # ---- D06: an unregistered root ----------------------------------------
    for _doc_agent in $KNOWN_AGENTS; do
        _doc_prefix=$(agent_def "$_doc_agent" root_prefix)
        for _doc_cand in "$HOME/$_doc_prefix"*; do
            [ -d "$_doc_cand" ] || continue
            _doc_known=""
            for _doc_name in $_doc_names; do
                _doc_regroot=$(reg_get "$_doc_name" root)
                [ "${_doc_regroot%/}" = "${_doc_cand%/}" ] && _doc_known=1
            done
            [ -n "$_doc_known" ] && continue
            finding "D06" "a $_doc_agent config root exists that no profile claims" \
                "$_doc_cand" \
                "Register it, or remove it if it is left over." \
                "Unregistered roots are invisible to every other check here."
        done
    done

    # ---- D15: two profiles claiming one root ------------------------------
    #
    # Nothing else catches this, and it makes the prompt label ambiguous: the
    # label resolves a root to a name, and with two names for one root it has
    # to pick one. It also means one account's sessions are being reported
    # under two identities everywhere else in this audit.
    for _doc_name in $_doc_names; do
        _doc_root=$(reg_get "$_doc_name" root)
        [ -n "$_doc_root" ] || continue
        _doc_sharers=""
        for _doc_other in $_doc_names; do
            [ "$_doc_other" = "$_doc_name" ] && continue
            [ "$(reg_get "$_doc_other" root)" = "$_doc_root" ] || continue
            _doc_sharers="$_doc_sharers $_doc_other"
        done
        # Report once, from the alphabetically first of the group.
        [ -n "$_doc_sharers" ] || continue
        _doc_first=$(printf '%s\n' "$_doc_name$_doc_sharers" | tr ' ' '\n' | sort | head -1)
        [ "$_doc_first" = "$_doc_name" ] || continue
        finding "D15" "more than one profile is registered at the same root" \
            "$_doc_root" \
            "profiles:$_doc_name$_doc_sharers" \
            "They are one account wearing several names, so every count and" \
            "label here is ambiguous, and a prompt has to pick one arbitrarily." \
            "Remove the registry entries you do not want from $AGENT_PROFILE_REGISTRY."
    done

    # ---- D14: a desktop launcher no profile claims ------------------------
    #
    # D13 audits the applet a profile names. This finds the ones nobody told
    # the tool about, and the two do not overlap: a machine can have a
    # registered applet pinning the wrong root and an unregistered one beside
    # it, and both are worth knowing.
    #
    # It exists because assuming launchers live in the conventional directory
    # is wrong on a real machine. Two working ones were sitting on a Desktop,
    # completely outside the audit, while doctor reported a clean desktop.
    for _doc_agent in $KNOWN_AGENTS; do
        _doc_scan=$(mktemp "${TMPDIR:-/tmp}/agent-profile-d14.XXXXXX") || \
            die "could not create a temporary file under ${TMPDIR:-/tmp}"
        applet_scan "$_doc_agent" > "$_doc_scan" 2>/dev/null

        # Read from a file rather than a pipe: a pipeline runs the loop in a
        # subshell and the finding count would not survive it. An applet path
        # can hold spaces, so never iterate it with word splitting.
        while IFS= read -r _doc_applet; do
            [ -n "$_doc_applet" ] || continue

            _doc_claimed=""
            for _doc_name in $_doc_names; do
                [ "$(reg_get "$_doc_name" applet)" = "$_doc_applet" ] && _doc_claimed=1
            done
            [ -n "$_doc_claimed" ] && continue

            # Naming the profile that owns the root turns this from a report
            # into an instruction.
            _doc_pins=$(applet_pinned_root "$_doc_agent" "$_doc_applet")
            _doc_owner=""
            for _doc_name in $_doc_names; do
                [ "$(reg_get "$_doc_name" root)" = "$_doc_pins" ] && _doc_owner="$_doc_name"
            done

            if [ -n "$_doc_owner" ]; then
                finding "D14" "a desktop launcher for profile '$_doc_owner' is not registered" \
                    "$_doc_applet" \
                    "It pins $_doc_pins, which profile '$_doc_owner' owns, but no profile" \
                    "names this applet, so the launcher audit has never read it." \
                    "An unregistered launcher is invisible to every other check here." \
                    "Fix with: $SELF app $_doc_owner --applet '$_doc_applet'"
            else
                finding "D14" "a $_doc_agent desktop launcher exists that no profile claims" \
                    "$_doc_applet" \
                    "It pins ${_doc_pins:-(no root this tool could read)}, which no registered" \
                    "profile owns. Register that root first with $SELF new," \
                    "then point a profile at this launcher with $SELF app --applet." \
                    "Until then nothing here audits what it launches."
            fi
        done < "$_doc_scan"
        rm -f "$_doc_scan"
    done

    # ---- D09: a deep-link handler that cannot carry a config root ---------
    #
    # The handler is launched by LaunchServices, which passes no environment
    # from any shell, so a link opens against whatever the default root is
    # regardless of what this tool has set up. See docs/FACTS.md F04.
    for _doc_agent in $KNOWN_AGENTS; do
        _doc_handler=$(agent_def "$_doc_agent" url_handler)
        [ -d "$_doc_handler" ] || continue
        finding "D09" "a $(agent_def "$_doc_agent" url_scheme):// handler is installed and cannot be pinned" \
            "$_doc_handler" \
            "LaunchServices passes no environment, so a deep link opens against the" \
            "default root whatever this tool has configured. Treat links as a leak" \
            "path: open the project through a pinned shell instead of clicking them."
    done

    # ---- D16: an IDE extension that cannot carry a config root ------------
    #
    # The same shape as D09, and for the same reason: a launch path this tool
    # cannot pin unless the thing that starts it was itself started pinned.
    # Nothing on disk records how an IDE was launched, so an installed
    # extension is reported every time and the finding names the pinned
    # launcher rather than pretending to know. See docs/FACTS.md F19 to F21.
    #
    # The two kinds get different prose because the mechanism genuinely
    # differs. The VS Code family spawns its own bundled agent from the
    # extension host, so no rc file is ever consulted and the guard cannot see
    # it. The JetBrains plugin types the command into the IDE's integrated
    # terminal, so a guard in an rc file does see it, and saying otherwise
    # would send a reader looking for a leak that is not there.
    for _doc_ide in $KNOWN_IDES; do
        _doc_ide_scan=$(mktemp "${TMPDIR:-/tmp}/agent-profile-d16.XXXXXX") || \
            die "could not create a temporary file under ${TMPDIR:-/tmp}"
        ide_scan "$_doc_ide" > "$_doc_ide_scan" 2>/dev/null

        # Read from a file rather than a pipe: a pipeline runs the loop in a
        # subshell and the finding count would not survive it.
        while IFS= read -r _doc_ext; do
            [ -n "$_doc_ext" ] || continue
            _doc_ide_label=$(ide_def "$_doc_ide" label)
            _doc_ide_cmd=$(ide_def "$_doc_ide" command)
            case "$(ide_def "$_doc_ide" kind)" in
                jetbrains)
                    finding "D16" "a Claude Code plugin for $_doc_ide_label is installed and cannot be pinned" \
                        "$_doc_ext" \
                        "The plugin runs the agent in the IDE's integrated terminal, so a guard" \
                        "in your rc file does see that call. What it does not see is the config" \
                        "root the IDE process was started with, which a Dock or Spotlight launch" \
                        "leaves unset. The plugin's own Config directory setting only chooses" \
                        "where it writes its lock file; it pins nothing." \
                        "Launch it pinned instead: $SELF $_doc_ide_cmd <profile> [path]"
                    ;;
                *)
                    finding "D16" "a Claude Code extension for $_doc_ide_label is installed and cannot be pinned" \
                        "$_doc_ext" \
                        "The extension spawns its own copy of the agent from the IDE's process," \
                        "so the shell guard never sees the call and the config root can only" \
                        "come from the environment the IDE was launched with. A Dock or" \
                        "Spotlight launch carries none, and every session started that way" \
                        "writes to the default root." \
                        "Launch it pinned instead: $SELF $_doc_ide_cmd <profile> [path]"
                    ;;
            esac
        done < "$_doc_ide_scan"
        rm -f "$_doc_ide_scan"
    done

    # Where a JetBrains IDE keeps its plugins is known for macOS only, so on
    # any other platform D16 has looked in two of its three places. Saying so
    # is the difference between a rule that passed and a rule that was half
    # blindfolded.
    if [ "$AGENT_PROFILE_PLATFORM" != "Darwin" ]; then
        emit data rule_status D16 limited \
            "the JetBrains plugin directory is only known for macOS, so a JetBrains install elsewhere was not checked"
    fi

    # ---- D11: what the Keychain says about the default root ---------------
    #
    # doctor reads (D11):
    #   keychain query: security find-generic-password, one named service per
    #     known agent (the default root's own credential service). Attributes
    #     only, via keychain_has; the credential value is never read.
    if keychain_available; then
        for _doc_agent in $KNOWN_AGENTS; do
            _doc_base=$(agent_def "$_doc_agent" cred_service)
            _doc_default=$(agent_def "$_doc_agent" default_root)

            # D11. A credential for the default root can only exist if the
            # variable was set to the default path. That is a different login
            # from not pinning at all, and it is how a default root ends up
            # holding one account's sessions while another runs unpinned.
            _doc_dhash=$(cred_info "$_doc_default" | cut -f2)
            _doc_claimed=""
            for _doc_name in $_doc_names; do
                [ "$(reg_get "$_doc_name" root)" = "$_doc_default" ] && _doc_claimed=1
            done
            if [ -z "$_doc_claimed" ] && keychain_has "$_doc_base-$_doc_dhash"; then
                finding "D11" "a credential exists for the default $_doc_agent root, so something ran pinned to it" \
                    "$_doc_base-$_doc_dhash  ($_doc_default)" \
                    "Setting the variable to the default path is not the same as leaving" \
                    "it unset: it is a separate login, stored under a separate entry." \
                    "The unpinned login is '$_doc_base' with no suffix."
            fi
        done

        # ---- D12: orphaned Keychain entries, opt-in ------------------------
        #
        # doctor reads (D12, only with --keychain-scan):
        #   keychain query: security dump-keychain, which enumerates every
        #     item in the login Keychain. keychain_services reads only the
        #     "svce" attribute of each; the credential value is never read.
        #
        # This is the one Keychain check that does not name a single service:
        # it walks the whole Keychain, which is slow when it holds a lot of
        # items and is worth asking about before it runs. D05 and D11 stay
        # unconditional because each of them queries one named service.
        if [ -n "$_doc_keychain_scan" ]; then
            for _doc_agent in $KNOWN_AGENTS; do
                _doc_base=$(agent_def "$_doc_agent" cred_service)
                _doc_default=$(agent_def "$_doc_agent" default_root)

                # Entries whose suffix matches no root on this machine. The
                # hash is one-way, so these can only be reported, never
                # resolved.
                _doc_dhash=$(cred_info "$_doc_default" | cut -f2)
                _doc_known="$_doc_base
$_doc_base-$_doc_dhash"
                for _doc_name in $_doc_names; do
                    _doc_r=$(reg_get "$_doc_name" root)
                    [ -n "$_doc_r" ] || continue
                    _doc_known="$_doc_known
$_doc_base-$(cred_info "$_doc_r" | cut -f2)"
                done

                _doc_orphans=$(keychain_services \
                    | grep -c -F -x -v -f <(printf '%s\n' "$_doc_known") 2>/dev/null)
                if [ "${_doc_orphans:-0}" -gt 0 ]; then
                    finding "D12" "$_doc_orphans Keychain credential entr(ies) belong to no known root" \
                        "service prefix: $_doc_base-" \
                        "Left over from roots that no longer exist, or from roots this tool" \
                        "does not know about. The suffix is a one-way hash, so they cannot be" \
                        "traced back to a path. Harmless, but they accumulate." \
                        "This tool will not delete them: it never touches credentials."
                fi
            done
        else
            emit normal rule_status D12 not_run \
                "the Keychain was not scanned, because --keychain-scan was not given" \
                "Orphaned Keychain entries were not checked (D12). Run \"$SELF doctor --keychain-scan\" to check them."
        fi
    else
        # Without a Keychain there is nothing for D11 or D12 to read, and D05
        # falls back to a weaker question. A document that reported any of the
        # three as passing here would be claiming a check that never ran.
        emit data rule_status D05 limited \
            "there is no Keychain on this system, so D05 asks only whether an account is on record"
        emit data rule_status D11 not_run "there is no Keychain on this system"
        emit data rule_status D12 not_run "there is no Keychain on this system"
    fi

    # The desktop rules read an applet by decompiling it, so without
    # osadecompile neither of them sees anything at all. That silence is
    # exactly what must not be reported as a pass.
    if ! command -v osadecompile >/dev/null 2>&1; then
        emit data rule_status D13 not_run \
            "osadecompile is not available, so no applet launch line could be read"
        emit data rule_status D14 not_run \
            "osadecompile is not available, so no applet could be scanned"
    fi

    # ---- D03: the same project under two roots ----------------------------
    #
    # This is the check that replaces a hand-maintained list of path prefixes
    # per profile. It needs no configuration, so it cannot go stale and cannot
    # pass quietly because nothing was declared.
    if [ ${#_doc_roots[@]} -gt 0 ]; then
        _doc_tmp=$(mktemp "${TMPDIR:-/tmp}/agent-profile-d03.XXXXXX") || \
            die "could not create a temporary file under ${TMPDIR:-/tmp}"
        read_project_cwds "${_doc_roots[@]}" | sed '/^$/d' | sort -u | \
            awk -F'\t' '
                { count[$2]++; roots[$2] = roots[$2] sep[$2] $1; sep[$2] = ", " }
                END { for (c in count) if (count[c] > 1) printf "%s\t%s\n", c, roots[c] }
            ' | sort > "$_doc_tmp"

        # Read from a file, not a pipe: a pipeline runs the loop in a subshell
        # and the finding count would not survive it.
        while IFS="$(printf '\t')" read -r _doc_cwd _doc_where; do
            [ -n "$_doc_cwd" ] || continue
            finding "D03" "the same project has sessions under more than one root" \
                "$_doc_cwd" \
                "found under: $_doc_where" \
                "One of these accounts has worked in the other's project."
        done < "$_doc_tmp"
        rm -f "$_doc_tmp"
    fi

    # ---- Summary -----------------------------------------------------------
    #
    # The exit code is part of the document as well as of the process, so a
    # report handed to someone else says what the run concluded.
    _doc_exit="$EX_OK"
    [ "$DOCTOR_FINDINGS" -eq 0 ] || _doc_exit="$EX_FINDINGS"

    if [ "$DOCTOR_FINDINGS" -eq 0 ] && [ -z "$_doc_names" ]; then
        emit always summary 2 findings 0 exit_code "$_doc_exit" \
            "No profiles registered, so there is nothing to audit." \
            "Create one:  $SELF new <name>"
    elif [ "$DOCTOR_FINDINGS" -eq 0 ]; then
        emit always summary 2 findings 0 exit_code "$_doc_exit" \
            "No isolation problems found across $(printf '%s\n' "$_doc_names" | wc -l | tr -d ' ') profile(s)."
    else
        emit always summary 2 findings "$DOCTOR_FINDINGS" exit_code "$_doc_exit" \
            "$DOCTOR_FINDINGS finding(s)."
    fi

    report_finish
    return "$_doc_exit"
}
# ---------------------------------------------------------------------------
# verify
#
# Re-checks the behavioural assumptions the tool rests on, against this machine
# and the agent version actually installed. The point is that the tool tells its
# owner when its own assumptions have stopped holding, rather than silently
# producing wrong answers. See docs/FACTS.md for the full record.
# ---------------------------------------------------------------------------

VERIFY_BROKEN=0
VERIFY_UNCHECKED=0

# verify_scan <state_base> <root>...: one pass, emits key=value counts.
verify_scan() {
    python3 - "$@" <<'PY'
import json, os, sys

state_base = sys.argv[1]
roots = sys.argv[2:]

state_files = with_account = 0
transcripts = with_cwd = 0
encoded_dirs = odd_dirs = 0
state_inside = 0

for root in roots:
    path = os.path.join(root, state_base)
    if os.path.isfile(path):
        state_files += 1
        state_inside += 1
        try:
            with open(path) as fh:
                data = json.load(fh)
            account = data.get("oauthAccount") or {}
            if account.get("emailAddress"):
                with_account += 1
        except Exception:
            pass

    projects = os.path.join(root, "projects")
    if not os.path.isdir(projects):
        continue
    for entry in os.listdir(projects):
        if not os.path.isdir(os.path.join(projects, entry)):
            continue
        if entry.startswith("-"):
            encoded_dirs += 1
        else:
            odd_dirs += 1

    for dirpath, _dirnames, filenames in os.walk(projects):
        for name in filenames:
            if not name.endswith(".jsonl"):
                continue
            transcripts += 1
            try:
                with open(os.path.join(dirpath, name), errors="replace") as fh:
                    for line in fh:
                        if '"cwd"' not in line:
                            continue
                        try:
                            record = json.loads(line)
                        except ValueError:
                            continue
                        if record.get("cwd"):
                            with_cwd += 1
                            break
            except OSError:
                pass

for key, value in [
    ("state_files", state_files),
    ("with_account", with_account),
    ("transcripts", transcripts),
    ("with_cwd", with_cwd),
    ("encoded_dirs", encoded_dirs),
    ("odd_dirs", odd_dirs),
]:
    print("%s=%d" % (key, value))
PY
}

# The four verdicts a fact can get. Each is one record, so the document lists
# what was checked and how it went in the order a reader sees it.
vok() {
    _vk_fact="$1"; _vk_sum="$2"; shift 2
    emit normal check ok "$_vk_fact" "$_vk_sum" "$@"
}

vbroken() {
    VERIFY_BROKEN=$((VERIFY_BROKEN + 1))
    _vb_fact="$1"; _vb_sum="$2"; shift 2
    emit normal check broken "$_vb_fact" "$_vb_sum" "$@"
}

vunchecked() {
    VERIFY_UNCHECKED=$((VERIFY_UNCHECKED + 1))
    _vu_fact="$1"; _vu_sum="$2"; shift 2
    emit normal check unchecked "$_vu_fact" "$_vu_sum" "$@"
}

vnote() {
    _vn_fact="$1"; _vn_sum="$2"; shift 2
    emit normal check note "$_vn_fact" "$_vn_sum" "$@"
}

cmd_verify() {
    while [ $# -gt 0 ]; do
        case "$1" in
            --json) REPORT_FORMAT=json ;;
            *) die "verify: unknown option '$1' (try: $SELF verify --json)" ;;
        esac
        shift
    done

    need python3
    VERIFY_BROKEN=0
    VERIFY_UNCHECKED=0
    [ "$REPORT_FORMAT" = "text" ] || report_open verify

    emit normal text \
        "Checking the assumptions $SELF rests on." \
        "Full record and evidence: docs/FACTS.md" \
        ""

    # ---- Agent version drift ----------------------------------------------
    for _ver_agent in $KNOWN_AGENTS; do
        _ver_bin=$(agent_def "$_ver_agent" binary)
        _ver_now=$(installed_agent_version "$_ver_agent")
        if [ -z "$_ver_now" ]; then
            vunchecked "----" "cannot read the installed $_ver_agent version" \
                "The '$_ver_bin' command is not on PATH."
        elif [ "$_ver_now" = "$AGENT_PROFILE_VERIFIED_AGAINST" ]; then
            vok "----" "$_ver_agent $_ver_now matches the version these facts were checked against"
        else
            vnote "----" "$_ver_agent is $_ver_now; facts were checked against $AGENT_PROFILE_VERIFIED_AGAINST" \
                "A newer version can change any of the below. The checks still run."
        fi
    done
    emit normal text ""

    # ---- Facts that need a real root --------------------------------------
    _ver_roots=()
    for _ver_name in $(profile_names); do
        _ver_root=$(reg_get "$_ver_name" root)
        [ -d "$_ver_root" ] && _ver_roots[${#_ver_roots[@]}]="$_ver_root"
    done

    if [ ${#_ver_roots[@]} -eq 0 ]; then
        # Say which of the two this is. "No root to inspect" on a machine that
        # has three of them sitting on disk is false, and the remedy it used to
        # offer -- create a profile and sign in -- is wrong for someone already
        # signed in to all of them and merely not registered yet.
        if [ -z "$(profile_names)" ]; then
            _ver_why="no profile is registered, so there is no root to read"
            _ver_hint="Roots already on this machine are not inspected until a profile claims one."
            _ver_next="Register them with: $SELF new <name> --root <path>"
        else
            _ver_why="every registered root is missing from disk"
            _ver_hint="The registry names roots that are not there, and doctor reports each as D04."
            _ver_next="Fix the registry before trusting anything here."
        fi
        vunchecked "F07" "$_ver_why" "$_ver_hint" "$_ver_next"
        vunchecked "F11" "$_ver_why" "This is the check that doctor's D03 depends on." "$_ver_next"
        vunchecked "F12" "$_ver_why" "$_ver_next"
    else
        _ver_state=$(agent_def claude state_base)
        # Initialised before the scan so a failed scan cannot leave them unset
        # under set -u, and so their origin is visible to a reader.
        state_files=0; with_account=0
        transcripts=0; with_cwd=0
        encoded_dirs=0; odd_dirs=0
        eval "$(verify_scan "$_ver_state" "${_ver_roots[@]}")"

        # F07: account identity key.
        if [ "$state_files" -eq 0 ]; then
            vunchecked "F07" "no root holds a state file yet" \
                "Sign in to a profile, then run verify again."
        elif [ "$with_account" -gt 0 ]; then
            vok "F07" "oauthAccount.emailAddress present in $with_account of $state_files state file(s)"
        else
            vbroken "F07" "no state file holds oauthAccount.emailAddress" \
                "$state_files state file(s) exist but none carry that key." \
                "The account identity key has probably moved or been renamed." \
                "list will report every profile as not signed in until this is fixed."
        fi

        # F11: transcripts record cwd. doctor's D03 is built on this, and if it
        # ever stops holding, D03 passes silently instead of failing loudly.
        if [ "$transcripts" -eq 0 ]; then
            vunchecked "F11" "no transcripts stored yet in any root" \
                "doctor's D03 cannot be exercised until a session has been recorded."
        elif [ "$with_cwd" -eq "$transcripts" ]; then
            vok "F11" "all $transcripts transcript(s) record their own cwd"
        elif [ "$with_cwd" -eq 0 ]; then
            vbroken "F11" "no transcript records a cwd, out of $transcripts" \
                "doctor's D03 detects cross-root leakage by reading cwd from" \
                "transcript metadata. It will now find nothing and pass quietly," \
                "which is worse than failing. Do not trust doctor until this is fixed."
        else
            vbroken "F11" "only $with_cwd of $transcripts transcript(s) record a cwd" \
                "doctor's D03 sees only part of the picture and may miss a leak."
        fi

        # F12: project directory naming.
        if [ "$odd_dirs" -gt 0 ]; then
            vnote "F12" "$odd_dirs project director(ies) are not encoded paths" \
                "CLAUDE_CODE_PROJECT_DIR_NAME was used. doctor reports these as D08."
        elif [ "$encoded_dirs" -gt 0 ]; then
            vok "F12" "all $encoded_dirs project director(ies) look like encoded paths"
        else
            vunchecked "F12" "no project directories to inspect"
        fi

        # F10: does the state file live inside a pinned root?
        if [ "$state_files" -gt 0 ]; then
            vok "F10" "the state file does live inside a pinned root ($state_files found)"
        else
            vunchecked "F10" "no pinned root holds a state file yet" \
                "Cannot confirm that setting the variable moves it inside the root."
        fi
    fi

    emit normal text ""

    # ---- Facts that need macOS and the desktop app ------------------------
    if [ "$AGENT_PROFILE_PLATFORM" != "Darwin" ]; then
        vunchecked "F13" "not running on macOS" "F01, F03, F04 and F05 need macOS too."
    else
        # F01 is answered and is not automatically checkable: settling it needs
        # a real app launch and a real Code session. It is a recorded fact, so
        # verify says how to re-confirm it rather than pretending to.
        # shellcheck disable=SC2016  # literal help text; the user types this
        vnote "F01" "the desktop app does honour the config-dir variable from its environment" \
            "Not checkable from here: it needs a real app launch." \
            "Re-confirm with: $SELF desktop <name>, start a Code" \
            'session, then: find "$HOME"/.claude* -name "*.jsonl" -mmin -3'

        # F13. The mechanism the whole desktop half rests on. If --env is gone,
        # desktop, app and D13 are all invalid at once, so this is broken
        # rather than unchecked: the tool would launch unpinned apps happily.
        if ! command -v open >/dev/null 2>&1; then
            vunchecked "F13" "no open command on PATH, so --env could not be exercised"
        elif open_supports_env; then
            vok "F13" "open still supports --env, so the desktop app can be pinned"
        else
            vbroken "F13" "open no longer supports --env" \
                "This is the only way a config root reaches the desktop app." \
                "desktop, app and doctor's D13 are all invalid until it is replaced." \
                "Do not trust an existing applet either: it will launch unpinned."
        fi

        # D13 reads an applet by decompiling it. Without osadecompile the
        # desktop audit silently checks nothing, which is the failure mode this
        # command exists to catch.
        if command -v osadecompile >/dev/null 2>&1; then
            vok "F13" "osadecompile is available, so doctor can read applet launch lines"
        else
            vunchecked "F13" "osadecompile is missing, so doctor's D13 cannot read any applet" \
                "It ships with macOS. Until it is back, the desktop half is unaudited."
        fi

        # F03 is known, so this is a real check now: the naming must still
        # produce an entry for a root that has a signed-in account.
        _ver_found=0
        _ver_missing=0
        if keychain_available; then
            for _ver_root in ${_ver_roots[@]+"${_ver_roots[@]}"}; do
                _ver_svc="$(agent_def claude cred_service)-$(cred_info "$_ver_root" | cut -f2)"
                if keychain_has "$_ver_svc"; then
                    _ver_found=$((_ver_found + 1))
                else
                    _ver_missing=$((_ver_missing + 1))
                fi
            done
            if [ "$_ver_found" -gt 0 ]; then
                vok "F03" "the Keychain naming still resolves: $_ver_found of $((_ver_found + _ver_missing)) root(s) found"
            elif [ "$_ver_missing" -gt 0 ] && [ "$with_account" -gt 0 ]; then
                vbroken "F03" "no root's credential was found under the expected Keychain name" \
                    "$with_account root(s) record a signed-in account, so entries should exist." \
                    "The service naming has probably changed. doctor's D05 will report" \
                    "false findings until docs/FACTS.md F03 is re-established." \
                    "Re-run: bash tools/probe-claude-desktop.sh"
            else
                if [ ${#_ver_roots[@]} -eq 0 ]; then
                    vunchecked "F03" "no registered root to check the Keychain naming against" \
                        "Register a profile first; an unregistered root is not read here."
                else
                    vunchecked "F03" "no registered root is signed in, so the naming could not be exercised"
                fi
            fi
        else
            vunchecked "F03" "no security command available"
        fi

        # F05: has the app binary moved since the recorded baseline?
        _ver_app="/Applications/Claude.app"
        if [ -d "$_ver_app" ]; then
            _ver_exe=$(defaults read "$_ver_app/Contents/Info.plist" CFBundleExecutable 2>/dev/null)
            if [ -n "$_ver_exe" ] && [ -x "$_ver_app/Contents/MacOS/$_ver_exe" ]; then
                vok "F05" "the app binary resolves via CFBundleExecutable ($_ver_exe)"
            else
                vbroken "F05" "the app binary is not where the bundle says it is" \
                    "Generated .app launchers will be broken until this is fixed."
            fi
        else
            vunchecked "F05" "Claude Desktop is not installed at $_ver_app"
        fi

        # F04: the deep-link handler is a known leak path, reported by D09.
        if [ -d "$(agent_def claude url_handler)" ]; then
            vnote "F04" "the claude-cli:// handler is installed; doctor reports it as D09"
        else
            vok "F04" "no claude-cli:// handler is installed, so there is no link leak path"
        fi
    fi

    # ---- The IDE extensions, F19 to F21 -----------------------------------
    #
    # F21 is what D16 scans, and D16 scans directories rather than asking the
    # IDE's own CLI, so its silence has two meanings. This is where they are
    # told apart: nothing installed is a pass, nothing looked at is unchecked.
    # Without it, an extensions directory that moved would turn D16 into a
    # rule that reports a clean machine because it looked in the wrong place.
    # F19 and F20 need a real IDE and a real session, the same way F01 does.
    # Both were established by reading the shipped extension and plugin rather
    # than by watching a session land in a root, so verify says how to settle
    # them rather than pretending it just did.
    # shellcheck disable=SC2016  # literal help text; the user types this
    vnote "F19" "the IDE extensions do take the config root from the IDE's process environment" \
        "Read from the shipped extension and plugin, not from a session that ran." \
        "Re-confirm with: $SELF code <name> <path>, start a session in the IDE," \
        'then: find "$HOME"/.claude* -name "*.jsonl" -mmin -3'

    vnote "F20" "a settings pin is not a launch pin, in either IDE family" \
        "VS Code's claudeCode.environmentVariables reaches the agent the extension" \
        "spawns but not the extension's own config home, and the JetBrains Config" \
        "directory setting only moves the plugin's lock file. Pin the IDE itself." \
        "See docs/FACTS.md F20."

    _ver_ide_found=0
    for _ver_ide in $KNOWN_IDES; do
        _ver_ide_hits=$(ide_scan "$_ver_ide" | grep -c '')
        _ver_ide_found=$((_ver_ide_found + _ver_ide_hits))
    done

    if [ "$_ver_ide_found" -gt 0 ]; then
        vok "F21" "$_ver_ide_found Claude Code IDE extension(s) found where D16 looks; doctor reports each as D16"
    elif ide_installed; then
        vnote "F21" "an IDE keeps its extensions here and none of them is Claude Code's" \
            "D16 will stay quiet, which is right if the extension is not installed and" \
            "wrong if the directory naming has moved since F21 was established." \
            "Settle it with: code --list-extensions | grep anthropic.claude-code"
    else
        vunchecked "F21" "no IDE extensions directory on this machine, so D16's scan was not exercised" \
            "Nothing here says whether D16 would find an extension on a machine that has one."
    fi

    emit normal text ""

    vnote "F02" "moot: the app's environment editor only mattered if F01 was negative"

    vnote "F06" "a root cannot be relocated without losing its login" \
        "Reasoned from F09, not tested: confirming it costs a real login." \
        "This is why there is no rename and no move command."

    # ---- Summary -----------------------------------------------------------
    emit normal text ""
    if [ "$VERIFY_BROKEN" -gt 0 ]; then
        emit always summary 3 \
            broken "$VERIFY_BROKEN" unchecked "$VERIFY_UNCHECKED" exit_code "$EX_BROKEN" \
            "$VERIFY_BROKEN assumption(s) no longer hold, $VERIFY_UNCHECKED could not be checked." \
            "Fix the tool before trusting doctor."
        report_finish
        return "$EX_BROKEN"
    fi
    if [ "$VERIFY_UNCHECKED" -gt 0 ]; then
        emit always summary 3 \
            broken 0 unchecked "$VERIFY_UNCHECKED" exit_code "$EX_UNCHECKED" \
            "Nothing broken. $VERIFY_UNCHECKED assumption(s) could not be checked here."
        report_finish
        return "$EX_UNCHECKED"
    fi
    emit always summary 3 broken 0 unchecked 0 exit_code "$EX_OK" \
        "Every assumption still holds."
    report_finish
    return "$EX_OK"
}

# ---------------------------------------------------------------------------
# explain
#
# For the reader who set this up months ago and has forgotten the details,
# possibly after an update that changed them. States the scheme in plain
# language and shows where this machine's data actually lives right now.
# ---------------------------------------------------------------------------

cmd_explain() {
    cat <<'PROSE'
THE SCHEME

A profile is one account, kept apart from every other account by giving it its
own config root. The root is chosen by an environment variable, and everything
the agent stores goes under it: settings, session transcripts, auto memory,
commands, skills, agents, plugins, plans, backups, the credential and the state
file. Two profiles therefore share no file at all.

Credentials are keyed to the root path. That is what makes separate roots give
genuinely separate logins, and it is also why a root can never be moved or
renamed: doing so invalidates its login. Create a new profile instead.

Pinning to the default root is not the same as not pinning. When the variable
is set, the state file moves inside the root, so the two produce different
layouts. Anything that runs with nothing pinned writes to the default root,
which is exactly what doctor reports.

TWO IDENTITIES, AND THEY CAN DISAGREE

A profile has two of them. The app data directory selects the desktop app's own
login, the one whose name you see in the app. The config root selects where its
embedded agent writes. They are independent, and they have already been seen
disagreeing: the app showed the right account for weeks while its sessions were
writing into another account's root. So the app naming an account is not
evidence that anything is pinned. Read both, always.

The terminal and the desktop are pinned by different means. In a terminal the
variable is exported, by run, shell or env. The desktop app gets it through
`open --env`, which is what `desktop` runs and what the applet `app` generates
contains. There is no third way that works: a bundle wrapping a shell script
never launches, and running the app binary from a terminal kills it when the
shell exits.

One more asymmetry worth knowing. A status line shows which root a terminal
session is using, but the desktop pane renders none, so there is no equivalent
indicator inside the app. For the desktop, the launcher is the guarantee and
doctor's D13 is the check.

NOTHING IS SHARED

No symlinks, no shared parent, no copied settings, no seeding a new root from an
old one, no template. A new root is empty. That means it also has none of the
hooks or guardrails your other profiles have, and the fix for that is to set
them up in the new root directly, never to copy them across.

WHAT THIS TOOL STORES

Only the registry, at the path shown below, outside every config root. One
plain key=value file per profile holding the agent, the root, the app data
directory, the applet that launches it and the creation date. Nothing else. The
label you see in a prompt is
derived from the pinned root every time it is needed, so it cannot drift away
from the root it names.

The tool never reads, writes or moves a credential, never edits the agent's own
state files, and never migrates data between roots.

PROSE

    printf 'ON THIS MACHINE\n\n'
    printf '  registry    %s\n' "$AGENT_PROFILE_REGISTRY"
    for _ex_agent in $KNOWN_AGENTS; do
        printf '\n  %s\n' "$_ex_agent"
        printf '    variable       %s\n' "$(agent_def "$_ex_agent" envvar)"
        printf '    binary         %s\n' "$(agent_def "$_ex_agent" binary)"
        printf '    default root   %s\n' "$(agent_def "$_ex_agent" default_root)"
        printf '    unpinned state %s\n' "$(agent_def "$_ex_agent" state_file)"
        printf '    desktop app    %s\n' "$(agent_def "$_ex_agent" app_bundle)"
    done

    printf '\n  profiles\n'
    _ex_names=$(profile_names)
    if [ -z "$_ex_names" ]; then
        printf '    (none registered)\n'
    else
        for _ex_name in $_ex_names; do
            printf '    %-12s root      %s\n' "$_ex_name" "$(reg_get "$_ex_name" root)"
            printf '    %-12s app data  %s\n' "" "$(reg_get "$_ex_name" app_data)"
            _ex_applet=$(reg_get "$_ex_name" applet)
            if [ -n "$_ex_applet" ]; then
                printf '    %-12s launcher  %s\n' "" "$_ex_applet"
            else
                printf '    %-12s launcher  (none; %s app %s)\n' "" "$SELF" "$_ex_name"
            fi
        done
    fi

    printf '\nAFTER AN AGENT UPDATE\n\n'
    printf '  Run: %s verify\n' "$SELF"
    printf '  It re-checks the behavioural assumptions this tool rests on and says\n'
    printf '  which it could not check. The answers and their evidence are recorded\n'
    printf '  in docs/FACTS.md in the repository.\n'
    printf '\n'
    printf '  There is no single agent version on a machine like this. Each desktop\n'
    printf '  profile downloads its own copy under its app data directory, so they\n'
    printf '  update independently of each other and of the CLI.\n'
}

# resolved_self: the command a generated script should call back into.
#
# Guard and completion both print scripts that call back into this tool from
# the user's shell, so both need a name that will still resolve there. Prefer
# the short name when it is on PATH; fall back to this script's absolute path
# when it is not, so a printed script is useful before the installer has been
# run.
resolved_self() {
    _rs_self="$SELF"
    if ! command -v "$SELF" >/dev/null 2>&1; then
        _rs_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
        [ -n "$_rs_dir" ] && _rs_self="$_rs_dir/${0##*/}"
    fi
    printf '%s\n' "$_rs_self"
}

# ---------------------------------------------------------------------------
# guard
#
# A shell function that refuses to run the agent unpinned. This is the only
# real mitigation for the hole the audit cannot close: an unpinned run writes
# to the default root, and if a profile owns that root, doctor can no longer
# tell the two apart (docs/FACTS.md F10). Stopping the run is what is left.
#
# It is printed rather than installed, and derived on every shell start rather
# than stored, for the same reason `which --label` is: a copy in a dotfile
# drifts from the tool, and this one would drift silently.
#
# bash and zsh share one function syntax, so one form covers both. fish does
# not, so --shell fish (or a $SHELL that ends in "fish", when --shell is not
# given) selects a second form written in fish syntax. Nothing else changes:
# same refusal, same leading-profile-name shortcut, same escape hatch.
# ---------------------------------------------------------------------------

cmd_guard() {
    _g_shell=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --shell) shift; [ $# -gt 0 ] || die "--shell needs a value"; _g_shell="$1" ;;
            *)       die "guard: unknown option '$1' (try: $SELF guard --shell bash|zsh|fish)" ;;
        esac
        shift
    done

    if [ -z "$_g_shell" ]; then
        case "${SHELL##*/}" in
            fish) _g_shell="fish" ;;
            *)    _g_shell="bash" ;;
        esac
    fi

    _g_self=$(resolved_self)

    case "$_g_shell" in
        fish)     guard_fish "$_g_self" ;;
        bash|zsh) guard_posix "$_g_self" ;;
        *)        die "guard: unknown shell '$_g_shell' (known: bash, zsh, fish)" ;;
    esac
}

# guard_posix <self>: the bash-and-zsh form, unchanged from before --shell
# existed. Kept byte-for-byte so the existing test suite still pins it.
guard_posix() {
    _gp_self="$1"
    for _gp_agent in $KNOWN_AGENTS; do
        _gp_bin=$(agent_def "$_gp_agent" binary)
        _gp_var=$(agent_def "$_gp_agent" envvar)
        cat <<GUARD
$_gp_bin() {
    if [ -z "\${$_gp_var:-}" ]; then
        # A first argument naming a profile means "use that one". This is safe
        # only here, with nothing pinned, because the alternative on this path
        # is a refusal: there is no working invocation to shadow. Once pinned,
        # the argument is left alone, since $_gp_bin takes a prompt there and
        # stealing a word that happens to match a profile name would break it.
        if [ \$# -gt 0 ] && $_gp_self path "\$1" >/dev/null 2>&1; then
            printf '%s\\n' "Pinning to \$1." >&2
            $_gp_self run "\$@"
            return \$?
        fi
        printf '%s\\n' "Refusing to run $_gp_bin unpinned." >&2
        printf '%s\\n' "Nothing is pinned, so this would write to the default root," >&2
        printf '%s\\n' "under whichever account last logged in there." >&2
        printf '%s\\n' "" >&2
        printf '%s\\n' "Name one to use it, for example: $_gp_bin <profile> [args...]" >&2
        printf '%s\\n' "" >&2
        printf '%s\\n' "Profiles on this machine:" >&2
        $_gp_self list 2>/dev/null | sed -n 's/^\\([a-zA-Z0-9_-][a-zA-Z0-9_-]*\\)\$/  \\1/p' >&2
        printf '%s\\n' "" >&2
        printf '%s\\n' "Or pin the shell: eval \\"\\\$($_gp_self env <profile>)\\"" >&2
        printf '%s\\n' "Override:         command $_gp_bin [args...]" >&2
        return 1
    fi
    command $_gp_bin "\$@"
}
GUARD
    done
}

# guard_fish <self>: same refusal, same shortcut, fish syntax. fish has no
# "$@"; the equivalent is $argv, and no exit-status variable named "$?"; the
# equivalent is $status. `set -q VAR` is fish's "is this variable set", the
# fish counterpart of bash's `[ -z "${VAR:-}" ]`.
guard_fish() {
    _gf_self="$1"
    for _gf_agent in $KNOWN_AGENTS; do
        _gf_bin=$(agent_def "$_gf_agent" binary)
        _gf_var=$(agent_def "$_gf_agent" envvar)
        cat <<GUARDFISH
function $_gf_bin
    if not set -q $_gf_var
        if test (count \$argv) -gt 0
            and $_gf_self path \$argv[1] >/dev/null 2>&1
            echo "Pinning to \$argv[1]." >&2
            $_gf_self run \$argv
            return \$status
        end
        echo "Refusing to run $_gf_bin unpinned." >&2
        echo "Nothing is pinned, so this would write to the default root," >&2
        echo "under whichever account last logged in there." >&2
        echo "" >&2
        echo "Name one to use it, for example: $_gf_bin <profile> [args...]" >&2
        echo "" >&2
        echo "Profiles on this machine:" >&2
        $_gf_self list 2>/dev/null | sed -n 's/^\\([a-zA-Z0-9_-][a-zA-Z0-9_-]*\\)\$/  \\1/p' >&2
        echo "" >&2
        echo "Or pin the shell: eval ($_gf_self env <profile> | string collect)" >&2
        echo "Override:         command $_gf_bin \$argv" >&2
        return 1
    end
    command $_gf_bin \$argv
end
GUARDFISH
    done
}

# ---------------------------------------------------------------------------
# completion
#
# Prints a completion script for bash, zsh or fish, covering every subcommand,
# its flags, and profile names. Printed rather than installed, for the same
# reason guard is: this tool never writes to a completion directory or an rc
# file, and a copy in one would drift from the tool as commands are added.
#
# Profile names are never baked into the printed script. Instead the script
# calls back into $SELF (resolved the same way guard resolves it) at
# completion time, the same trick guard already uses to list profiles when it
# refuses a run, so a profile added after the script was sourced still
# completes without re-sourcing anything.
# ---------------------------------------------------------------------------

cmd_completion() {
    [ $# -eq 1 ] || die "usage: $SELF completion bash|zsh|fish"
    _co_self=$(resolved_self)
    case "$1" in
        bash) completion_bash "$_co_self" ;;
        zsh)  completion_zsh "$_co_self" ;;
        fish) completion_fish "$_co_self" ;;
        *)    die "completion: unknown shell '$1' (known: bash, zsh, fish)" ;;
    esac
}

completion_bash() {
    cat <<'BASHCOMP' | sed "s/@SELF@/$SELF/g; s|@AP@|$1|g"
# @SELF@ bash completion.
# Add to your shell rc file:
#   eval "$(@SELF@ completion bash)"

__@SELF@_profiles() {
    @AP@ list 2>/dev/null | sed -n 's/^\([a-zA-Z0-9_-][a-zA-Z0-9_-]*\)$/\1/p'
}

_@SELF@_complete() {
    local cur prev cmds
    COMPREPLY=()
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"
    cmds="new list ls remove run shell env path which guard desktop code idea app doctor verify explain completion version help"

    if [ "$COMP_CWORD" -eq 1 ]; then
        COMPREPLY=( $(compgen -W "$cmds $(__@SELF@_profiles)" -- "$cur") )
        return 0
    fi

    case "${COMP_WORDS[1]}" in
        new)
            case "$prev" in
                --agent)           COMPREPLY=( $(compgen -W "claude" -- "$cur") ); return 0 ;;
                --root|--app-data) return 0 ;;
            esac
            COMPREPLY=( $(compgen -W "--agent --root --app-data" -- "$cur") )
            ;;
        remove)
            COMPREPLY=( $(compgen -W "$(__@SELF@_profiles) --purge" -- "$cur") )
            ;;
        run|shell|env|path|desktop)
            COMPREPLY=( $(compgen -W "$(__@SELF@_profiles)" -- "$cur") )
            ;;
        code|idea)
            case "$prev" in
                --app) return 0 ;;
            esac
            COMPREPLY=( $(compgen -W "$(__@SELF@_profiles) --app" -- "$cur") )
            ;;
        app)
            case "$prev" in
                --applet|--icon) return 0 ;;
            esac
            COMPREPLY=( $(compgen -W "$(__@SELF@_profiles) --applet --icon" -- "$cur") )
            ;;
        which)
            COMPREPLY=( $(compgen -W "--label" -- "$cur") )
            ;;
        guard)
            case "$prev" in
                --shell) COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") ); return 0 ;;
            esac
            COMPREPLY=( $(compgen -W "--shell" -- "$cur") )
            ;;
        doctor)
            COMPREPLY=( $(compgen -W "--keychain-scan" -- "$cur") )
            ;;
        version)
            COMPREPLY=( $(compgen -W "--check" -- "$cur") )
            ;;
        completion)
            COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") )
            ;;
    esac
}
complete -F _@SELF@_complete @SELF@
BASHCOMP
}

completion_zsh() {
    cat <<'ZSHCOMP' | sed "s/@SELF@/$SELF/g; s|@AP@|$1|g"
#compdef @SELF@
# @SELF@ zsh completion.
# Add to your shell rc file:
#   eval "$(@SELF@ completion zsh)"

__@SELF@_profiles() {
    @AP@ list 2>/dev/null | sed -n 's/^\([a-zA-Z0-9_-][a-zA-Z0-9_-]*\)$/\1/p'
}

_@SELF@() {
    local -a cmds profiles
    cmds=(
        'new:create a profile'
        'list:list every profile'
        'ls:list every profile'
        'remove:retire a profile'
        'run:run the agent pinned to a profile'
        'shell:open a subshell pinned to a profile'
        'env:print exports, for eval'
        'path:print the config root of a profile'
        'which:which profile this shell is pinned to'
        'guard:print the unpinned-run guard'
        'desktop:launch the desktop app pinned to a profile'
        'code:launch VS Code pinned to a profile'
        'idea:launch a JetBrains IDE pinned to a profile'
        'app:build the Dock launcher'
        'doctor:audit that the isolation holds'
        'verify:re-check the assumptions this tool rests on'
        'explain:explain the scheme'
        'completion:print a shell completion script'
        'version:print the version'
        'help:show help'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'command' cmds
        profiles=(${(f)"$(__@SELF@_profiles)"})
        _describe -t profiles 'profile' profiles
        return
    fi

    case ${words[2]} in
        new)
            _arguments '--agent[agent]:agent:(claude)' \
                '--root[config root path]:path:_files -/' \
                '--app-data[app data dir path]:path:_files -/'
            ;;
        remove)
            profiles=(${(f)"$(__@SELF@_profiles)"})
            _describe -t profiles 'profile' profiles
            _arguments '--purge[delete everything, after a typed confirmation]'
            ;;
        run|shell|env|path|desktop)
            profiles=(${(f)"$(__@SELF@_profiles)"})
            _describe -t profiles 'profile' profiles
            ;;
        code|idea)
            profiles=(${(f)"$(__@SELF@_profiles)"})
            _describe -t profiles 'profile' profiles
            _arguments '--app[application to launch]:application:' \
                '*:path:_files -/'
            ;;
        app)
            profiles=(${(f)"$(__@SELF@_profiles)"})
            _describe -t profiles 'profile' profiles
            _arguments '--applet[applet path]:path:_files' \
                '--icon[1024px PNG]:png:_files -g \*.png'
            ;;
        which)
            _arguments '--label[print the bare label only]'
            ;;
        guard)
            _arguments '--shell[shell to target]:shell:(bash zsh fish)'
            ;;
        doctor)
            _arguments '--keychain-scan[also scan the whole login Keychain]'
            ;;
        version)
            _arguments '--check[compare against the newest release]'
            ;;
        completion)
            _values 'shell' bash zsh fish
            ;;
    esac
}

compdef _@SELF@ @SELF@
ZSHCOMP
}

completion_fish() {
    cat <<'FISHCOMP' | sed "s/@SELF@/$SELF/g; s|@AP@|$1|g"
# @SELF@ fish completion.
# Add to your shell config (~/.config/fish/config.fish):
#   @SELF@ completion fish | source

function __@SELF@_profiles
    @AP@ list 2>/dev/null | string match -r '^[a-zA-Z0-9_-]+$'
end

complete -c @SELF@ -f

complete -c @SELF@ -n '__fish_use_subcommand' -a new -d 'Create a profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a list -d 'List every profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a ls -d 'List every profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a remove -d 'Retire a profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a run -d 'Run the agent pinned to a profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a shell -d 'Open a subshell pinned to a profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a env -d 'Print exports, for eval'
complete -c @SELF@ -n '__fish_use_subcommand' -a path -d 'Print the config root of a profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a which -d 'Which profile this shell is pinned to'
complete -c @SELF@ -n '__fish_use_subcommand' -a guard -d 'Print the unpinned-run guard'
complete -c @SELF@ -n '__fish_use_subcommand' -a desktop -d 'Launch the desktop app pinned to a profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a code -d 'Launch VS Code pinned to a profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a idea -d 'Launch a JetBrains IDE pinned to a profile'
complete -c @SELF@ -n '__fish_use_subcommand' -a app -d 'Build the Dock launcher'
complete -c @SELF@ -n '__fish_use_subcommand' -a doctor -d 'Audit that the isolation holds'
complete -c @SELF@ -n '__fish_use_subcommand' -a verify -d 'Re-check the assumptions this tool rests on'
complete -c @SELF@ -n '__fish_use_subcommand' -a explain -d 'Explain the scheme'
complete -c @SELF@ -n '__fish_use_subcommand' -a completion -d 'Print a shell completion script'
complete -c @SELF@ -n '__fish_use_subcommand' -a version -d 'Print the version'
complete -c @SELF@ -n '__fish_use_subcommand' -a help -d 'Show help'
complete -c @SELF@ -n '__fish_use_subcommand' -a '(__@SELF@_profiles)' -d Profile

complete -c @SELF@ -n '__fish_seen_subcommand_from run shell env path desktop remove app code idea' -a '(__@SELF@_profiles)' -d Profile

complete -c @SELF@ -n '__fish_seen_subcommand_from new' -l agent -d Agent -a claude
complete -c @SELF@ -n '__fish_seen_subcommand_from new' -l root -d 'Config root path'
complete -c @SELF@ -n '__fish_seen_subcommand_from new' -l app-data -d 'App data dir path'
complete -c @SELF@ -n '__fish_seen_subcommand_from remove' -l purge -d 'Delete everything, after a typed confirmation'
complete -c @SELF@ -n '__fish_seen_subcommand_from code idea' -l app -d 'Application to launch'
complete -c @SELF@ -n '__fish_seen_subcommand_from app' -l applet -d 'Applet path'
complete -c @SELF@ -n '__fish_seen_subcommand_from app' -l icon -d '1024px PNG'
complete -c @SELF@ -n '__fish_seen_subcommand_from which' -l label -d 'Print the bare label only'
complete -c @SELF@ -n '__fish_seen_subcommand_from guard' -l shell -d 'Shell to target' -a 'bash zsh fish'
complete -c @SELF@ -n '__fish_seen_subcommand_from doctor' -l keychain-scan -d 'Also scan the whole login Keychain'
complete -c @SELF@ -n '__fish_seen_subcommand_from version' -l check -d 'Compare against the newest release'
complete -c @SELF@ -n '__fish_seen_subcommand_from completion' -a 'bash zsh fish'
FISHCOMP
}

# ---------------------------------------------------------------------------
# The picker
#
# Bare `agpin` on a terminal asks which profile and which surface, because
# opening a pinned app is the thing people do many times a day and it should
# not need eight characters of subcommand first.
#
# Every prompt is gated on stdin being a terminal. Piped or scripted, this
# never runs: the old behaviour, help and exit 1, is what a reader gets, so
# nothing that consumes output can hang waiting for an answer.
# ---------------------------------------------------------------------------

is_tty() {
    [ -n "$AGENT_PROFILE_ASSUME_TTY" ] && return 0
    [ -t 0 ] && [ -t 2 ]
}

# ask_choice <prompt> <item>...
#
# Numbers the items on stderr, reads a choice, and echoes the chosen item on
# stdout. Returns 1 if the answer is empty or out of range, so a stray Return
# cancels rather than picking something.
ask_choice() {
    _ac_prompt="$1"; shift
    [ $# -gt 0 ] || return 1

    _ac_i=0
    for _ac_item in "$@"; do
        _ac_i=$((_ac_i + 1))
        printf '  %s) %s\n' "$_ac_i" "$_ac_item" >&2
    done
    printf '\n%s [1-%s, Return to cancel]: ' "$_ac_prompt" "$_ac_i" >&2

    read -r _ac_answer || return 1
    case "$_ac_answer" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$_ac_answer" -ge 1 ] && [ "$_ac_answer" -le "$_ac_i" ] || return 1

    _ac_i=0
    for _ac_item in "$@"; do
        _ac_i=$((_ac_i + 1))
        if [ "$_ac_i" = "$_ac_answer" ]; then
            printf '%s\n' "$_ac_item"
            return 0
        fi
    done
    return 1
}

cmd_pick() {
    _pk_names=$(profile_names)
    if [ -z "$_pk_names" ]; then
        printf 'No profiles registered yet.\n' >&2
        printf 'Create one:  %s new <name>\n' "$SELF" >&2
        return "$EX_ERR"
    fi

    printf 'Which profile?\n' >&2
    # shellcheck disable=SC2086  # names are validated, one word each
    _pk_name=$(ask_choice "Profile" $_pk_names) || {
        printf 'Nothing chosen.\n' >&2
        return "$EX_ERR"
    }

    printf '\nWhere?\n' >&2
    _pk_where=$(ask_choice "Open" "desktop app" "terminal" "subshell") || {
        printf 'Nothing chosen.\n' >&2
        return "$EX_ERR"
    }

    printf '\n' >&2
    case "$_pk_where" in
        "desktop app") cmd_desktop "$_pk_name" ;;
        subshell)      cmd_shell "$_pk_name" ;;
        *)             cmd_run "$_pk_name" ;;
    esac
}

# ---------------------------------------------------------------------------
# version, help
# ---------------------------------------------------------------------------

# latest_release_tag: the newest release's tag, from the GitHub API.
#
# Read with sed rather than python3 on purpose. Everything else here already
# needs python3, but this is the one command someone runs on a machine that has
# just been handed to them, and python3 on a fresh Mac opens the Command Line
# Tools dialog. tag_name is a plain string, and the API emits it well before
# the release body, so the first match is the field rather than something
# quoted inside prose.
latest_release_tag() {
    _lrt_json=$(curl -fsSL "$AGENT_PROFILE_RELEASE_API_URL" 2>/dev/null) || return 1
    _lrt_tag=$(printf '%s\n' "$_lrt_json" \
        | tr ',' '\n' \
        | sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -1)
    [ -n "$_lrt_tag" ] || return 1
    printf '%s\n' "$_lrt_tag"
}

# version_lt <a> <b>: true when version a is older than version b.
#
# Field by field and numerically, because 0.10.0 is newer than 0.9.9 and a
# string comparison says the opposite. Anything after a hyphen is dropped: this
# project publishes no pre-releases, and treating one as newer than the release
# it precedes would be worse than ignoring it.
version_lt() {
    _vl_a=${1%%-*}
    _vl_b=${2%%-*}
    _vl_i=1
    while [ "$_vl_i" -le 3 ]; do
        _vl_x=$(printf '%s' "$_vl_a" | cut -d. -f"$_vl_i")
        _vl_y=$(printf '%s' "$_vl_b" | cut -d. -f"$_vl_i")
        case "$_vl_x" in ''|*[!0-9]*) _vl_x=0 ;; esac
        case "$_vl_y" in ''|*[!0-9]*) _vl_y=0 ;; esac
        [ "$_vl_x" -lt "$_vl_y" ] && return 0
        [ "$_vl_x" -gt "$_vl_y" ] && return 1
        _vl_i=$((_vl_i + 1))
    done
    return 1
}

# --check compares the running version against the newest release and says
# which. It downloads nothing but that one answer and installs nothing at all:
# a tool that updates itself is a tool that can be made to run new code without
# anybody deciding to, which is the whole thing this release process is for.
cmd_version() {
    _ver_check=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --check) _ver_check=1 ;;
            *) die "version: unknown option '$1' (try: $SELF version --check)" ;;
        esac
        shift
    done

    if [ -z "$_ver_check" ]; then
        printf '%s %s\n' "$SELF" "$AGENT_PROFILE_VERSION"
        printf '%s\n' "$AGENT_PROFILE_LICENSE"
        return "$EX_OK"
    fi

    need curl
    _ver_tag=$(latest_release_tag) || die "could not ask $AGENT_PROFILE_RELEASE_API_URL what the newest release is.
Check your network. Nothing was downloaded and nothing was changed."
    _ver_latest="${_ver_tag#v}"

    printf 'installed  %s\n' "$AGENT_PROFILE_VERSION"
    printf 'latest     %s\n' "$_ver_latest"
    printf '\n'

    if version_lt "$AGENT_PROFILE_VERSION" "$_ver_latest"; then
        printf '%s is behind, and installs nothing on its own. Update with:\n' "$SELF"
        printf '  curl -fsSL https://raw.githubusercontent.com/mmsge/agent-profile-manager/hovud/tools/install.sh | bash\n'
        return "$EX_ERR"
    fi

    if [ "$AGENT_PROFILE_VERSION" = "$_ver_latest" ]; then
        printf '%s is up to date.\n' "$SELF"
    else
        printf '%s is newer than the newest release, so this is a build of your own.\n' "$SELF"
    fi
    return "$EX_OK"
}

cmd_help() {
    # Quoted heredoc, so the literal $( ) in the help text survives. The
    # command's own name is put back afterwards rather than expanded here.
    cat <<'HELP' | sed "s/@SELF@/$SELF/g"
@SELF@: Agent Profile Manager

Keeps several agent accounts separate on one machine by giving each its own
config root, and audits that the separation actually holds.

USAGE
  @SELF@                  Ask which profile and where to open it.
  @SELF@ <command> [arguments]

PROFILES
  new <name> [--agent NAME] [--root PATH] [--app-data PATH]
                          Create an empty config root, an app data dir and a
                          registry entry. Safe to run twice.
  list [--json]           Every profile with its root, account and session count.
  remove <name> [--purge] Retire a profile. It removes the registry entry and
                          prints everything else the profile still has on this
                          machine, with the command that deletes each one.
                          --purge deletes the root, the app data dir and the
                          launcher too, after you type the name back at a
                          prompt, and only from a terminal. It never touches
                          the credential, in either form.

PINNED EXECUTION
  <name> [args...]        Run the agent's CLI pinned to that profile. A bare
                          profile name is short for run.
  run <name> [args...]    Run the agent's CLI pinned to a profile.
  shell <name>            Open an interactive subshell pinned to a profile.
  env <name>              Print exports. Use: eval "$(@SELF@ env work)"
  path <name>             Print a profile's config root.
  which [--label]         Which profile this shell is pinned to, if any.

IDEs
  code <name> [path] [--app NAME]
                          Launch VS Code pinned to a profile, opening PATH if
                          given. --app names another application in the same
                          family, such as --app Cursor.
  idea <name> [path] [--app NAME]
                          The same for the JetBrains IDEs, IntelliJ IDEA by
                          default; --app PyCharm and so on.
                          An IDE started any other way runs its Claude Code
                          extension unpinned, because the extension takes the
                          config root from the IDE's own process environment
                          and a Dock or Spotlight launch carries none. doctor
                          reports an installed extension as D16.

DESKTOP
  desktop <name>          Launch the desktop app pinned to a profile. Running
                          @SELF@ with no arguments asks instead.
  app <name> [--applet PATH] [--icon PNG]
                          Generate or repair the AppleScript applet that
                          launches a profile from the Dock. Safe to run twice,
                          and it says which of the two happened. --icon takes a
                          1024px PNG; at Dock size only a single initial and a
                          distinct colour per account are legible.

SHELL
  guard [--shell bash|zsh|fish]
                          Print a shell function that refuses to run the agent
                          unpinned, and turns a leading profile name into a
                          pinned run. bash and zsh share one form; fish gets
                          its own, chosen by --shell or by reading $SHELL when
                          --shell is not given. Add to your rc file:
                            eval "$(@SELF@ guard)"
  completion bash|zsh|fish
                          Print a completion script covering every subcommand,
                          its flags, and profile names. Profile names are
                          looked up when the shell asks, not baked into the
                          script, so a new profile completes without
                          re-sourcing anything. Add to your rc file:
                            eval "$(@SELF@ completion bash)"    # bash
                            eval "$(@SELF@ completion zsh)"     # zsh
                            @SELF@ completion fish | source     # fish

AUDIT
  doctor [--json] [--report FILE] [--keychain-scan]
                          Check that the profiles are actually isolated.
                          --keychain-scan also enumerates the whole login
                          Keychain for orphaned entries (D12), which reads
                          every item's attributes and is slow on a large
                          Keychain, so it is off by default.
                          --json prints the audit as one JSON document.
                          --report writes FILE.json and FILE.md, a dated
                          audit of this machine to hand to someone else.
                          The exit code is the same either way.
                          Schema: docs/AUDIT-SCHEMA.md
  verify [--json]         Re-check the behavioural assumptions this tool rests on.
  explain                 Explain the scheme and where each profile's data lives.

OTHER
  version [--check]       Print the version. --check compares it against the
                          newest release and exits non-zero when this one is
                          behind. It downloads nothing and installs nothing.
  help

EXIT CODES
  0  success, nothing to report
  1  usage error, unknown profile or agent, missing dependency,
     version --check found a newer release, or remove was aborted or
     could not delete everything it was asked to
  2  doctor found an isolation problem
  3  verify found an assumption that no longer holds
  4  verify could not check something it wanted to check

Nothing is ever shared, copied or symlinked between two config roots.
HELP
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------

main() {
    # No arguments, on a terminal, means "ask me". Anywhere else it stays what
    # it was: help, and a non-zero exit.
    if [ $# -eq 0 ]; then
        if is_tty; then
            cmd_pick
            exit $?
        fi
        cmd_help
        exit "$EX_ERR"
    fi
    _main_cmd="$1"; shift
    case "$_main_cmd" in
        new)      cmd_new "$@" ;;
        list|ls)  cmd_list "$@" ;;
        remove)   cmd_remove "$@" ;;
        run)      cmd_run "$@" ;;
        shell)    cmd_shell "$@" ;;
        env)      cmd_env "$@" ;;
        path)     cmd_path "$@" ;;
        which)    cmd_which "$@" ;;
        guard)    cmd_guard "$@" ;;
        completion) cmd_completion "$@" ;;
        desktop)  cmd_desktop "$@" ;;
        code)     cmd_ide code "$@" ;;
        idea)     cmd_ide idea "$@" ;;
        app)      cmd_app "$@" ;;
        doctor)   cmd_doctor "$@" ;;
        verify)   cmd_verify "$@" ;;
        explain)  cmd_explain "$@" ;;
        version|--version|-V) cmd_version "$@" ;;
        help|--help|-h)       cmd_help ;;
        # A bare profile name runs it. Every subcommand is matched above, so
        # a subcommand always wins and a profile can never shadow one: the
        # worst case for a profile named after a command is that it needs the
        # explicit "run" form, not that anything breaks.
        *)
            if profile_exists "$_main_cmd"; then
                cmd_run "$_main_cmd" "$@"
            else
                die "unknown command or profile '$_main_cmd'
Try: $SELF help for commands, or $SELF list for profiles."
            fi
            ;;
    esac
}

main "$@"
